# Only non-secret Docker Compose settings belong here.
# Hermes v0.22.3 was released 2026-10-21; verify the image tag on the VPS.
# For reproducibility, replace the tag with a verified repo@sha256 digest before promotion.
HERMES_IMAGE=nousresearch/hermes-agent:0.22.3
HERMES_DATA_DIR=/srv/nix-hermes-discord/data

# Agent model credentials and Discord tokens belong ONLY in private profile .env files
# under HERMES_DATA_DIR/profiles/{lnx,lno}/.env (mode 0600), never in Git.
