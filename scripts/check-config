#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_file=${1:-${CONFIG_FILE:-.env}}
pinned_hermes_gids="$repo_root/deploy/hermes/pinned-system-gids.txt"

fail() {
  printf 'configuration error: %s\n' "$*" >&2
  exit 1
}

read_config() {
  local key=$1
  local value
  value=$(grep -E "^${key}=" "$config_file" | tail -n 1 | cut -d= -f2- || true)
  printf '%s' "$value"
}

require_config() {
  local key=$1
  local value
  value=$(read_config "$key")
  [[ -n "$value" ]] || fail "$key is missing or empty in $config_file"
  printf '%s' "$value"
}

secret_value() {
  local secret_file=$1
  local key=$2
  local value
  value=$(grep -E "^${key}=" "$secret_file" | tail -n 1 | cut -d= -f2- || true)
  [[ -n "$value" ]] || fail "$key is missing or empty in $secret_file"
  printf '%s' "$value"
}

secret_must_not_match_any() {
  local label=$1
  shift
  if ! printf '%s\0' "$@" | python3 -c '
import hmac
import sys

values = sys.stdin.buffer.read().split(b"\0")
if values and values[-1] == b"":
    values.pop()
if len(values) < 2:
    raise SystemExit(2)
candidate, others = values[0], values[1:]
collision = 0
for other in others:
    collision |= int(hmac.compare_digest(candidate, other))
raise SystemExit(1 if collision else 0)
'; then
    fail "$label must be distinct from every control-plane and specialist credential"
  fi
}

private_mode() {
  local secret_file=$1
  local mode
  if mode=$(stat -c '%a' "$secret_file" 2>/dev/null); then
    :
  else
    mode=$(stat -f '%Lp' "$secret_file")
  fi
  (( (8#$mode & 077) == 0 )) || fail "$secret_file must not be group/world accessible (current mode $mode)"
}

file_owner_uid() {
  if stat -c '%u' "$1" >/dev/null 2>&1; then
    stat -c '%u' "$1"
  else
    stat -f '%u' "$1"
  fi
}

file_group_gid() {
  if stat -c '%g' "$1" >/dev/null 2>&1; then
    stat -c '%g' "$1"
  else
    stat -f '%g' "$1"
  fi
}

file_mode() {
  if stat -c '%a' "$1" >/dev/null 2>&1; then
    stat -c '%a' "$1"
  else
    stat -f '%Lp' "$1"
  fi
}

file_link_count() {
  if stat -c '%h' "$1" >/dev/null 2>&1; then
    stat -c '%h' "$1"
  else
    stat -f '%l' "$1"
  fi
}

command -v docker >/dev/null 2>&1 || fail "docker is required"
docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is required"
command -v python3 >/dev/null 2>&1 || fail "python3 is required"
[[ -f "$config_file" ]] || fail "$config_file does not exist; copy .env.example and replace placeholders"

if grep -Eq '^(POSTGRES_PASSWORD|PAPERCLIP_DB_PASSWORD|DATABASE_URL|BETTER_AUTH_SECRET|PAPERCLIP_TOOL_ACTION_SIGNING_SECRET|API_SERVER_KEY|HERMES_DECISION_WEBHOOK_SECRET|WEBHOOK_SECRET|NIX_FOUNDER_RELAY_SECRET|NIX_LIOR_TELEGRAM_USER_ID|NIX_LIOR_TELEGRAM_CHAT_ID|TELEGRAM_BOT_TOKEN|PAPERCLIP_API_KEY|DAYTONA_API_KEY|OPENCODE_API_KEY|OPENCODE_GO_API_KEY|OPENCODE_ZEN_API_KEY)=' "$config_file"; then
  fail "$config_file contains a secret key; put secrets only in the external secret files"
fi

project_name=$(require_config COMPOSE_PROJECT_NAME)
public_url=$(require_config PAPERCLIP_PUBLIC_URL)
runner_public_url=$(require_config PAPERCLIP_RUNNER_PUBLIC_URL)
lior_paperclip_user_id=$(require_config PAPERCLIP_LIOR_USER_ID)
host_port=$(require_config PAPERCLIP_HOST_PORT)
postgres_env=$(require_config POSTGRES_ENV_FILE)
paperclip_env=$(require_config PAPERCLIP_ENV_FILE)
hermes_env=$(require_config HERMES_ENV_FILE)
founder_relay_env=$(require_config FOUNDER_RELAY_ENV_FILE)
hermes_telegram_bot_username=$(require_config HERMES_TELEGRAM_BOT_USERNAME)
hermes_mode_file=$(require_config HERMES_TELEGRAM_MODE_FILE)
specialist_provider_env=$(require_config SPECIALIST_PROVIDER_ENV_FILE)
specialist_worker_host_key=$(require_config SPECIALIST_WORKER_HOST_KEY_FILE)
specialist_worker_authorized_keys=$(require_config SPECIALIST_WORKER_AUTHORIZED_KEYS_FILE)
specialist_worker_client_key=$(require_config SPECIALIST_WORKER_CLIENT_KEY_FILE)
nix_brain_path=$(require_config NIX_BRAIN_HOST_PATH)
nix_brain_gid=$(require_config NIX_BRAIN_GID)
signup_disabled=$(require_config PAPERCLIP_AUTH_DISABLE_SIGN_UP)
chief_agent_id=$(require_config NIX_CHIEF_AGENT_ID)
approved_project_id=$(require_config NIX_APPROVED_PROJECT_ID)

specialist_keys=(
  NIX_PRODUCT_AGENT_ID
  NIX_GROWTH_AGENT_ID
  NIX_OPERATIONS_AGENT_ID
  NIX_SPECIALIST_AGENT_IDS
  NIX_PRODUCT_ENVIRONMENT_ID
  NIX_GROWTH_ENVIRONMENT_ID
  NIX_OPERATIONS_ENVIRONMENT_ID
  NIX_SPECIALIST_ENVIRONMENT_IDS
)
for specialist_key in "${specialist_keys[@]}"; do
  grep -q "^${specialist_key}=" "$config_file" \
    || fail "$specialist_key must be present (empty is allowed only before first specialist bootstrap)"
done
product_agent_id=$(read_config NIX_PRODUCT_AGENT_ID)
growth_agent_id=$(read_config NIX_GROWTH_AGENT_ID)
operations_agent_id=$(read_config NIX_OPERATIONS_AGENT_ID)
specialist_agent_ids=$(read_config NIX_SPECIALIST_AGENT_IDS)
product_environment_id=$(read_config NIX_PRODUCT_ENVIRONMENT_ID)
growth_environment_id=$(read_config NIX_GROWTH_ENVIRONMENT_ID)
operations_environment_id=$(read_config NIX_OPERATIONS_ENVIRONMENT_ID)
specialist_environment_ids=$(read_config NIX_SPECIALIST_ENVIRONMENT_IDS)

[[ "$project_name" =~ ^[a-z0-9][a-z0-9_-]{0,47}$ ]] \
  || fail "COMPOSE_PROJECT_NAME must be 1-48 characters matching [a-z0-9][a-z0-9_-]*"
[[ "$runner_public_url" == "wss://${public_url#https://}" ]] \
  || fail "PAPERCLIP_RUNNER_PUBLIC_URL must be the exact wss form of PAPERCLIP_PUBLIC_URL"
[[ "$signup_disabled" == "true" || "$signup_disabled" == "false" ]] || fail "PAPERCLIP_AUTH_DISABLE_SIGN_UP must be true or false"
[[ "$host_port" =~ ^[0-9]+$ ]] || fail "PAPERCLIP_HOST_PORT must be an integer"
[[ "$lior_paperclip_user_id" =~ ^[A-Za-z0-9._:-]{3,200}$ ]] \
  || fail "PAPERCLIP_LIOR_USER_ID has an invalid shape"
canonical_uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
[[ "$chief_agent_id" =~ $canonical_uuid ]] \
  || fail "NIX_CHIEF_AGENT_ID must be a canonical lowercase UUID"
[[ "$approved_project_id" =~ $canonical_uuid ]] \
  || fail "NIX_APPROVED_PROJECT_ID must be a canonical lowercase UUID"

specialist_present=0
for specialist_value in \
  "$product_agent_id" "$growth_agent_id" "$operations_agent_id" \
  "$specialist_agent_ids" "$product_environment_id" "$growth_environment_id" \
  "$operations_environment_id" "$specialist_environment_ids"; do
  [[ -z "$specialist_value" ]] || ((specialist_present += 1))
done
if (( specialist_present != 0 && specialist_present != 8 )); then
  fail "specialist IDs must be all empty before first bootstrap or all configured"
fi
if (( specialist_present == 8 )); then
  for specialist_id in \
    "$product_agent_id" "$growth_agent_id" "$operations_agent_id" \
    "$product_environment_id" "$growth_environment_id" "$operations_environment_id"; do
    [[ "$specialist_id" =~ $canonical_uuid ]] \
      || fail "specialist agent and environment IDs must be canonical lowercase UUIDs"
  done
  [[ "$product_agent_id" != "$growth_agent_id" \
    && "$product_agent_id" != "$operations_agent_id" \
    && "$growth_agent_id" != "$operations_agent_id" ]] \
    || fail "Product, Growth, and Operations agent IDs must be distinct"
  [[ "$chief_agent_id" != "$product_agent_id" \
    && "$chief_agent_id" != "$growth_agent_id" \
    && "$chief_agent_id" != "$operations_agent_id" ]] \
    || fail "the Chief must not appear in the specialist allowlist"
  [[ "$product_environment_id" != "$growth_environment_id" \
    && "$product_environment_id" != "$operations_environment_id" \
    && "$growth_environment_id" != "$operations_environment_id" ]] \
    || fail "specialist environment IDs must be distinct"
  [[ "$specialist_agent_ids" == "$product_agent_id,$growth_agent_id,$operations_agent_id" ]] \
    || fail "NIX_SPECIALIST_AGENT_IDS must exactly list Product,Growth,Operations in order"
  [[ "$specialist_environment_ids" == "$product_environment_id,$growth_environment_id,$operations_environment_id" ]] \
    || fail "NIX_SPECIALIST_ENVIRONMENT_IDS must exactly list Product,Growth,Operations environments in order"
fi
[[ "$hermes_telegram_bot_username" =~ ^[A-Za-z0-9_]{5,32}$ ]] \
  || fail "HERMES_TELEGRAM_BOT_USERNAME must be a bare Telegram username"
[[ $(printf '%s' "$hermes_telegram_bot_username" | tr '[:upper:]' '[:lower:]') == *bot ]] \
  || fail "HERMES_TELEGRAM_BOT_USERNAME must end in bot"

if [[ ${NIX_ALLOW_TEST_CONFIG:-0} != 1 ]]; then
  [[ "$public_url" =~ ^https://nix-os\.[a-z0-9-]+\.ts\.net$ ]] \
    || fail "PAPERCLIP_PUBLIC_URL must be the discovered https://nix-os.<tailnet-name>.ts.net URL"
  (( host_port >= 1024 && host_port <= 65535 )) || fail "PAPERCLIP_HOST_PORT must be between 1024 and 65535"
else
  [[ "$public_url" =~ ^https://[^/]+$ ]] || fail "PAPERCLIP_PUBLIC_URL must be an HTTPS origin without a path"
  (( host_port >= 0 && host_port <= 65535 )) || fail "test PAPERCLIP_HOST_PORT must be between 0 and 65535"
fi

secret_files=(
  "$postgres_env"
  "$paperclip_env"
  "$hermes_env"
  "$founder_relay_env"
  "$specialist_provider_env"
  "$specialist_worker_host_key"
  "$specialist_worker_authorized_keys"
  "$specialist_worker_client_key"
)
for (( secret_index = 0; secret_index < ${#secret_files[@]}; secret_index += 1 )); do
  secret_file=${secret_files[$secret_index]}
  [[ "$secret_file" == /* ]] || fail "secret file paths must be absolute: $secret_file"
  [[ "$secret_file" != *[$'\t\r\n ']* ]] || fail "secret file paths must not contain whitespace: $secret_file"
  for (( prior_index = 0; prior_index < secret_index; prior_index += 1 )); do
    [[ "$secret_file" != "${secret_files[$prior_index]}" ]] \
      || fail "secret file paths must be distinct: $secret_file"
  done
  [[ -f "$secret_file" && ! -L "$secret_file" ]] || fail "secret file is missing or unsafe: $secret_file"
  [[ $(file_link_count "$secret_file") == 1 ]] || fail "secret files must not have hard links: $secret_file"
  private_mode "$secret_file"
done

if [[ ${NIX_ALLOW_TEST_CONFIG:-0} != 1 ]]; then
  for secret_file in "${secret_files[@]}"; do
    [[ $(file_owner_uid "$secret_file") == 0 ]] || fail "external secret files must be owned by root: $secret_file"
  done
fi

[[ "$hermes_mode_file" == /* ]] || fail "HERMES_TELEGRAM_MODE_FILE must be absolute"
[[ -f "$hermes_mode_file" && ! -L "$hermes_mode_file" ]] || fail "Hermes Telegram mode marker is missing or unsafe: $hermes_mode_file"
private_mode "$hermes_mode_file"
if hermes_mode_permissions=$(stat -c '%a' "$hermes_mode_file" 2>/dev/null); then
  :
else
  hermes_mode_permissions=$(stat -f '%Lp' "$hermes_mode_file")
fi
[[ "$hermes_mode_permissions" == 600 ]] \
  || fail "Hermes Telegram mode marker must be mode 0600 (current mode $hermes_mode_permissions)"
[[ $(wc -l <"$hermes_mode_file" | tr -d ' ') == 1 ]] \
  || fail "Hermes Telegram mode marker must contain exactly one line"
hermes_mode=$(grep -E '^HERMES_TELEGRAM_MODE=(disabled|live)$' "$hermes_mode_file" || true)
[[ -n "$hermes_mode" ]] || fail "Hermes Telegram mode marker must be disabled or live"
if [[ ${NIX_ALLOW_TEST_CONFIG:-0} != 1 ]]; then
  [[ $(file_owner_uid "$hermes_mode_file") == 0 ]] || fail "Hermes Telegram mode marker must be owned by root"
fi

[[ "$nix_brain_path" == /* ]] || fail "NIX_BRAIN_HOST_PATH must be absolute"
[[ -d "$nix_brain_path" && ! -L "$nix_brain_path" ]] \
  || fail "NIX_BRAIN_HOST_PATH must be a real directory, not a symlink"
[[ "$nix_brain_gid" =~ ^[1-9][0-9]*$ ]] || fail "NIX_BRAIN_GID must be a positive numeric group ID"
actual_nix_brain_gid=$(file_group_gid "$nix_brain_path")
[[ "$nix_brain_gid" == "$actual_nix_brain_gid" ]] \
  || fail "NIX_BRAIN_GID must exactly match the group of NIX_BRAIN_HOST_PATH"
brain_mode=$(file_mode "$nix_brain_path")
(( (8#$brain_mode & 050) == 050 )) \
  || fail "NIX_BRAIN_HOST_PATH must grant its group read and traverse permissions"
(( (8#$brain_mode & 007) == 0 )) \
  || fail "NIX_BRAIN_HOST_PATH must not grant permissions to other users"
[[ -f "$pinned_hermes_gids" ]] || fail "pinned Hermes system-group inventory is missing"
if [[ "$nix_brain_gid" != 10000 ]] && grep -qx "$nix_brain_gid" "$pinned_hermes_gids"; then
  fail "NIX_BRAIN_GID collides with a group in the pinned Hermes image"
fi

postgres_password=$(secret_value "$postgres_env" POSTGRES_PASSWORD)
paperclip_db_password=$(secret_value "$postgres_env" PAPERCLIP_DB_PASSWORD)
database_url=$(secret_value "$paperclip_env" DATABASE_URL)
better_auth_secret=$(secret_value "$paperclip_env" BETTER_AUTH_SECRET)
tool_action_secret=$(secret_value "$paperclip_env" PAPERCLIP_TOOL_ACTION_SIGNING_SECRET)

(( ${#postgres_password} >= 32 )) || fail "POSTGRES_PASSWORD must be at least 32 characters"
(( ${#paperclip_db_password} >= 32 )) || fail "PAPERCLIP_DB_PASSWORD must be at least 32 characters"
[[ "$postgres_password" != "$paperclip_db_password" ]] || fail "PostgreSQL admin and Paperclip role passwords must differ"
(( ${#better_auth_secret} >= 32 )) || fail "BETTER_AUTH_SECRET must be at least 32 characters"
(( ${#tool_action_secret} >= 32 )) || fail "PAPERCLIP_TOOL_ACTION_SIGNING_SECRET must be at least 32 characters"
[[ "$database_url" == "postgresql://paperclip:${paperclip_db_password}@postgres:5432/paperclip" ]] || fail "DATABASE_URL must use PAPERCLIP_DB_PASSWORD and target paperclip@postgres:5432/paperclip"

api_server_key=$(secret_value "$hermes_env" API_SERVER_KEY)
decision_webhook_secret=$(secret_value "$hermes_env" HERMES_DECISION_WEBHOOK_SECRET)
upstream_webhook_secret=$(secret_value "$hermes_env" WEBHOOK_SECRET)
opencode_go_api_key=$(secret_value "$hermes_env" OPENCODE_GO_API_KEY)
telegram_token=$(secret_value "$hermes_env" TELEGRAM_BOT_TOKEN)
telegram_users=$(secret_value "$hermes_env" TELEGRAM_ALLOWED_USERS)
telegram_home=$(secret_value "$hermes_env" TELEGRAM_HOME_CHANNEL)
telegram_allow_all=$(secret_value "$hermes_env" TELEGRAM_ALLOW_ALL_USERS)
gateway_allow_all=$(secret_value "$hermes_env" GATEWAY_ALLOW_ALL_USERS)
founder_relay_secret=$(secret_value "$founder_relay_env" NIX_FOUNDER_RELAY_SECRET)
founder_telegram_user=$(secret_value "$founder_relay_env" NIX_LIOR_TELEGRAM_USER_ID)
founder_telegram_chat=$(secret_value "$founder_relay_env" NIX_LIOR_TELEGRAM_CHAT_ID)
specialist_provider_key=$(secret_value "$specialist_provider_env" OPENCODE_API_KEY)

if grep -Eq '^[[:space:]]*(export[[:space:]]+)?OPENCODE_GO_BASE_URL[[:space:]]*=' "$hermes_env"; then
  fail "Hermes external environment must not override the reviewed OpenCode Go endpoint"
fi

(( ${#api_server_key} >= 64 )) || fail "API_SERVER_KEY must be at least 64 characters"
[[ "$decision_webhook_secret" =~ ^[0-9a-f]{64}$ ]] \
  || fail "HERMES_DECISION_WEBHOOK_SECRET must be exactly 256 bits encoded as lowercase hex"
[[ "$decision_webhook_secret" != "$api_server_key" ]] \
  || fail "Hermes Runs API and decision webhook secrets must be distinct"
[[ "$upstream_webhook_secret" == "$decision_webhook_secret" ]] \
  || fail "WEBHOOK_SECRET must exactly match HERMES_DECISION_WEBHOOK_SECRET"
(( ${#opencode_go_api_key} >= 20 )) || fail "OPENCODE_GO_API_KEY is missing or too short"
[[ "$opencode_go_api_key" != REPLACE_WITH_OPENCODE_GO_API_KEY ]] || fail "OPENCODE_GO_API_KEY placeholder must be replaced"
[[ "$telegram_allow_all" == false && "$gateway_allow_all" == false ]] || fail "Hermes allow-all access must remain false"
[[ "$telegram_users" =~ ^[0-9]+$ ]] || fail "TELEGRAM_ALLOWED_USERS must contain exactly Lior's numeric user ID in Slice 1"
[[ "$telegram_home" == "$telegram_users" ]] \
  || fail "TELEGRAM_HOME_CHANNEL must exactly match the sole allowed Telegram user"
[[ "$founder_relay_secret" =~ ^[0-9a-f]{64}$ ]] \
  || fail "NIX_FOUNDER_RELAY_SECRET must be exactly 256 bits encoded as lowercase hex"
[[ "$founder_relay_secret" != "$api_server_key" && "$founder_relay_secret" != "$decision_webhook_secret" ]] \
  || fail "founder relay, Hermes Runs API, and decision webhook secrets must be distinct"
[[ "$founder_telegram_user" =~ ^[0-9]+$ && "$founder_telegram_chat" == "$founder_telegram_user" ]] \
  || fail "founder relay must contain one numeric direct-message Telegram identity"
[[ "$founder_telegram_user" == "$telegram_users" && "$founder_telegram_chat" == "$telegram_home" ]] \
  || fail "founder relay Telegram identity must match the validated Hermes single-user chat"
[[ $(grep -Ec '^(NIX_FOUNDER_RELAY_SECRET|NIX_LIOR_TELEGRAM_USER_ID|NIX_LIOR_TELEGRAM_CHAT_ID)=' "$founder_relay_env" || true) == 3 ]] \
  || fail "founder relay environment must contain exactly its three reviewed bindings"
[[ $(wc -l <"$founder_relay_env" | tr -d ' ') == 3 ]] \
  || fail "founder relay environment must not contain additional bindings"
[[ $(grep -Ec '^OPENCODE_API_KEY=' "$specialist_provider_env" || true) == 1 ]] \
  || fail "specialist provider import file must contain exactly OPENCODE_API_KEY"
[[ $(wc -l <"$specialist_provider_env" | tr -d ' ') == 1 ]] \
  || fail "specialist provider import file must not contain additional bindings"
(( ${#specialist_provider_key} >= 20 )) \
  || fail "specialist OPENCODE_API_KEY is missing or too short"
[[ "$specialist_provider_key" != REPLACE_WITH_RESTRICTED_OPENCODE_API_KEY ]] \
  || fail "specialist OPENCODE_API_KEY placeholder must be replaced"
command -v ssh-keygen >/dev/null 2>&1 || fail "ssh-keygen is required"
host_public=$(ssh-keygen -y -f "$specialist_worker_host_key" 2>/dev/null) \
  || fail "specialist worker host key is invalid"
client_public=$(ssh-keygen -y -f "$specialist_worker_client_key" 2>/dev/null) \
  || fail "specialist worker client key is invalid"
[[ "$host_public" == ssh-ed25519\ * && "$client_public" == ssh-ed25519\ * ]] \
  || fail "specialist worker SSH keys must be Ed25519"
authorized=$(cat "$specialist_worker_authorized_keys")
[[ "$authorized" == "restrict $client_public"* ]] \
  || fail "specialist worker authorized key does not match the configured client key"
[[ $(awk 'NF { count += 1 } END { print count + 0 }' "$specialist_worker_authorized_keys") == 1 ]] \
  || fail "specialist worker authorized-keys file must contain exactly one key"
privileged_or_unrelated_secrets=(
  "$postgres_password"
  "$paperclip_db_password"
  "$better_auth_secret"
  "$tool_action_secret"
  "$api_server_key"
  "$decision_webhook_secret"
  "$telegram_token"
  "$founder_relay_secret"
)
secret_must_not_match_any \
  "specialist OPENCODE_API_KEY" \
  "$specialist_provider_key" "${privileged_or_unrelated_secrets[@]}"
if [[ ${NIX_ALLOW_TEST_CONFIG:-0} != 1 ]]; then
  [[ "$telegram_token" =~ ^[0-9]{6,}:[A-Za-z0-9_-]{30,}$ ]] || fail "TELEGRAM_BOT_TOKEN does not match the BotFather token shape"
else
  [[ -n "$telegram_token" ]] || fail "TELEGRAM_BOT_TOKEN is required"
fi

docker compose --env-file "$config_file" config --quiet
printf 'Configuration is valid for Compose project %s.\n' "$project_name"
