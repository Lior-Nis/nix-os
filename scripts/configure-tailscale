#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_file=${1:-${CONFIG_FILE:-$repo_root/.env}}
state_tmp_dir=''

cleanup() {
  [[ -z "$state_tmp_dir" ]] || rm -rf "$state_tmp_dir"
}
trap cleanup EXIT

fail() {
  printf 'Tailscale Serve configuration error: %s\n' "$*" >&2
  exit 1
}

read_config() {
  grep -E "^${1}=" "$config_file" | tail -n 1 | cut -d= -f2- || true
}

for command_name in tailscale jq curl python3; do
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is required"
done

[[ -f "$config_file" ]] || fail "$config_file does not exist"
id nix >/dev/null 2>&1 || fail "Linux operator user nix does not exist"

status_json=$(tailscale status --json) || fail "cannot read Tailscale status"
[[ $(jq -r '.BackendState' <<<"$status_json") == Running ]] || fail "Tailscale is not connected"

sudo tailscale set --hostname=nix-os
sudo tailscale set --operator=nix

fqdn=''
for _ in {1..10}; do
  status_json=$(tailscale status --json)
  fqdn=$(jq -r '.Self.DNSName // empty' <<<"$status_json")
  fqdn=${fqdn%.}
  [[ "$fqdn" == nix-os.*.ts.net ]] && break
  sleep 1
done
[[ "$fqdn" == nix-os.*.ts.net ]] || fail "MagicDNS did not report the expected nix-os.<tailnet>.ts.net name (got ${fqdn:-none})"

public_url=$(read_config PAPERCLIP_PUBLIC_URL)
expected_fqdn=${public_url#https://}
[[ "$expected_fqdn" == "$fqdn" ]] || fail "PAPERCLIP_PUBLIC_URL hostname $expected_fqdn does not match MagicDNS $fqdn"

host_port=$(read_config PAPERCLIP_HOST_PORT)
if [[ ! "$host_port" =~ ^[0-9]+$ ]] || (( host_port < 1024 || host_port > 65535 )); then
  fail "PAPERCLIP_HOST_PORT must be between 1024 and 65535"
fi
curl --fail --silent --show-error "http://127.0.0.1:${host_port}/api/health" >/dev/null \
  || fail "Paperclip is not healthy on the configured loopback port"

state_tmp_dir=$(mktemp -d /tmp/nix-os-tailscale-state.XXXXXX)
target="http://127.0.0.1:${host_port}"

# Nix owns the complete Serve/Funnel configuration on this dedicated node.
# Inspect it, reset it through the supported CLI, prove the reset is empty,
# and then install only the desired background route. This removes persisted
# Funnel state and makes repeat runs converge on the same complete config.
tailscale serve status --json >"$state_tmp_dir/before.json"
"$repo_root/scripts/check-tailscale-serve-state" --expect inspect "$state_tmp_dir/before.json"
printf '%s\n' 'Resetting Nix-owned Tailscale Serve/Funnel state on the dedicated nix-os node.'
tailscale serve reset
tailscale serve status --json >"$state_tmp_dir/reset.json"
"$repo_root/scripts/check-tailscale-serve-state" --expect empty "$state_tmp_dir/reset.json"

# --bg persists across daemon and host restarts. Explicit port 443 and root
# path make the intended state unambiguous.
tailscale serve --bg --yes --https=443 "$target"
tailscale serve status --json >"$state_tmp_dir/final.json"
"$repo_root/scripts/check-tailscale-serve-state" \
  --expect paperclip --fqdn "$fqdn" --target "$target" "$state_tmp_dir/final.json"

curl --fail --silent --show-error "https://${fqdn}/api/health" >/dev/null \
  || fail "Paperclip is not healthy through Tailscale Serve"

printf 'Tailscale Serve is configured exclusively for https://%s:443/ -> %s.\n' "$fqdn" "$target"
