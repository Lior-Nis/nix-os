#!/usr/bin/env python3
"""Verify the fail-closed Paperclip topology for task-scoped specialists."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import stat
import subprocess
import sys
from typing import Any


REPO_ROOT = pathlib.Path(__file__).resolve().parents[1]
UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-"
    r"[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}"
)
ENVIRONMENT_MARKER = {"kind": "nix-specialist-ssh-worker", "version": 1}
AGENT_MARKER = {"kind": "nix-task-scoped-specialist", "version": 1}
MODEL = "opencode/gpt-5.6-luna"
ARCHIVE_HELPER_IMAGE = "postgres:17.11-alpine3.24@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"
ROLE_SPECS = {
    "product": ("Product", "pm"),
    "growth": ("Growth", "cmo"),
    "operations": ("Operations", "general"),
}


class TopologyError(RuntimeError):
    pass


def read_config(path: pathlib.Path, key: str) -> str:
    if not path.is_file():
        raise TopologyError(f"configuration file does not exist: {path}")
    values: list[str] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        if raw.startswith(f"{key}="):
            value = raw.split("=", 1)[1].strip()
            if len(value) >= 2 and value[:1] == value[-1:] and value[0] in "\"'":
                value = value[1:-1]
            values.append(value)
    if len(values) != 1 or not values[0]:
        raise TopologyError(f"{key} must appear exactly once and be nonempty in {path}")
    return values[0]


def read_locked_file(path: pathlib.Path, label: str) -> str:
    if not path.is_absolute():
        raise TopologyError(f"{label} path must be absolute")
    try:
        metadata = path.lstat()
    except OSError:
        raise TopologyError(f"{label} is missing") from None
    if (
        stat.S_ISLNK(metadata.st_mode)
        or not stat.S_ISREG(metadata.st_mode)
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
    ):
        raise TopologyError(f"{label} must be a single-link mode-0600 regular file")
    if os.geteuid() == 0 and metadata.st_uid != 0:
        raise TopologyError(f"{label} must be root-owned")
    value = path.read_text(encoding="utf-8")
    if not value.strip():
        raise TopologyError(f"{label} is empty")
    return value


def read_provider_key_file(path: pathlib.Path) -> dict[str, str]:
    contents = read_locked_file(path, "specialist provider import file")
    lines = contents.splitlines()
    values: dict[str, str] = {}
    for line in lines:
        key, separator, value = line.partition("=")
        if separator != "=" or key != "OPENCODE_API_KEY" or key in values:
            raise TopologyError(
                "specialist provider import file must contain only OPENCODE_API_KEY"
            )
        values[key] = value
    if set(values) != {"OPENCODE_API_KEY"}:
        raise TopologyError("specialist provider import file must contain OPENCODE_API_KEY")
    if any(
        not value or value != value.strip() or value.startswith("REPLACE_WITH_") or "\x00" in value
        for value in values.values()
    ):
        raise TopologyError("specialist provider import file does not contain a usable key")
    return values


def ssh_public_key(path: pathlib.Path, label: str) -> str:
    read_locked_file(path, label)
    completed = subprocess.run(
        ["ssh-keygen", "-y", "-f", str(path)], check=False, capture_output=True, text=True
    )
    fields = completed.stdout.strip().split()
    if completed.returncode != 0 or len(fields) < 2 or fields[0] != "ssh-ed25519":
        raise TopologyError(f"{label} is not a valid Ed25519 key")
    return f"{fields[0]} {fields[1]}"


def require_uuid(value: str, label: str) -> str:
    if not UUID_RE.fullmatch(value):
        raise TopologyError(f"{label} is not a valid UUID")
    return value


def specialist_ids_from_config(config_path: pathlib.Path) -> dict[str, str]:
    result = {
        slug: require_uuid(read_config(config_path, f"NIX_{slug.upper()}_AGENT_ID"), f"{slug} agent ID")
        for slug in ROLE_SPECS
    }
    ordered = read_config(config_path, "NIX_SPECIALIST_AGENT_IDS").split(",")
    expected = list(result.values())
    if ordered != expected or len(set(ordered)) != len(ordered):
        raise TopologyError(
            "NIX_SPECIALIST_AGENT_IDS must list Product, Growth, and Operations exactly once in order"
        )
    return result


def expected_permissions(company_id: str, project_id: str, specialist_ids: list[str]) -> dict[str, Any]:
    # The upstream low_trust_review preset only supports the sandbox driver.
    # The SSH specialists rely on their explicit Paperclip authority patch and
    # the credential-minimal Docker worker boundary instead.
    del company_id, project_id, specialist_ids
    return {
        "canCreateAgents": False,
        "canCreateSkills": False,
        "canAssignTasks": True,
        "trustPreset": "standard",
        "authorizationPolicy": {"trustPreset": "standard"},
    }


def expected_adapter_config(company_id: str, agent_id: str) -> dict[str, Any]:
    instructions_root = (
        f"/paperclip/instances/default/companies/{company_id}/agents/{agent_id}/instructions"
    )
    return {
        "provider": "opencode",
        "codexPermissionMode": "ask",
        "model": MODEL,
        "opencodePermissionMode": "deny",
        "lifecycleMode": "per_turn",
        "instructionsFilePath": f"{instructions_root}/AGENTS.md",
        "instructionsRootPath": instructions_root,
        "instructionsEntryFile": "AGENTS.md",
        "instructionsBundleMode": "managed",
    }


def verify_instruction_bundles(
    config_path: pathlib.Path,
    company_id: str,
    specialist_ids: dict[str, str],
) -> None:
    require_uuid(company_id, "specialist company ID")
    if set(specialist_ids) != set(ROLE_SPECS):
        raise TopologyError("specialist instruction identity map is invalid")
    arguments: list[str] = []
    for slug in ROLE_SPECS:
        agent_id = require_uuid(str(specialist_ids[slug]), f"{slug} agent ID")
        source = REPO_ROOT / "deploy" / "specialists" / f"{slug}.md"
        if not source.is_file() or source.is_symlink():
            raise TopologyError(f"tracked {slug} specialist instructions are missing or unsafe")
        arguments.extend((slug, agent_id, hashlib.sha256(source.read_bytes()).hexdigest()))

    project_name = read_config(config_path, "COMPOSE_PROJECT_NAME")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", project_name):
        raise TopologyError("COMPOSE_PROJECT_NAME is unsafe for instruction verification")
    volume = f"{project_name}_paperclip_data"
    run(["docker", "volume", "inspect", volume], label="Paperclip instruction volume lookup")
    script = r'''set -eu
company=$1
shift
while test "$#" -gt 0; do
  slug=$1
  agent_id=$2
  expected_digest=$3
  shift 3
  root="/paperclip/instances/default/companies/$company/agents/$agent_id/instructions"
  file="$root/AGENTS.md"
  test -d "$root" && test ! -L "$root"
  test "$(find "$root" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')" = 1
  test -f "$file" && test ! -L "$file"
  test "$(stat -c %h "$file")" = 1
  test "$(sha256sum "$file" | cut -d ' ' -f 1)" = "$expected_digest"
  cmp -s "$file" "/expected/$slug.md"
done'''
    run(
        [
            "docker", "run", "--rm", "--network", "none", "--read-only",
            "--volume", f"{volume}:/paperclip:ro",
            "--volume", f"{REPO_ROOT / 'deploy' / 'specialists'}:/expected:ro",
            ARCHIVE_HELPER_IMAGE, "sh", "-ec", script, "instruction-verifier", company_id,
            *arguments,
        ],
        label="specialist managed instruction bundle verification",
    )


def build_topology_query(
    chief_id: str,
    project_id: str,
    environment_ids: dict[str, str],
    specialist_ids: dict[str, str],
) -> str:
    for label, value in {
        "Chief agent ID": chief_id,
        "approved project ID": project_id,
        **{f"{slug} environment ID": environment_id for slug, environment_id in environment_ids.items()},
        **{f"{slug} agent ID": agent_id for slug, agent_id in specialist_ids.items()},
    }.items():
        require_uuid(value, label)
    specialist_sql = ",".join(f"'{value}'::uuid" for value in specialist_ids.values())
    environment_sql = ",".join(f"'{value}'::uuid" for value in environment_ids.values())
    marker = '{"kind":"nix-task-scoped-specialist","version":1}'
    environment_marker = '{"kind":"nix-specialist-ssh-worker","version":1}'
    return f"""
SELECT json_build_object(
  'chief', (
    SELECT json_build_object(
      'id', id::text,
      'companyId', company_id::text,
      'name', name,
      'role', role,
      'status', status,
      'reportsTo', reports_to::text,
      'adapterType', adapter_type,
      'adapterConfig', adapter_config,
      'permissions', permissions
    ) FROM agents WHERE id = '{chief_id}'::uuid
  ),
  'project', (
    SELECT json_build_object('id', id::text, 'companyId', company_id::text)
    FROM projects WHERE id = '{project_id}'::uuid
  ),
  'agents', COALESCE((
    SELECT json_agg(json_build_object(
      'id', id::text,
      'companyId', company_id::text,
      'name', name,
      'role', role,
      'title', title,
      'status', status,
      'reportsTo', reports_to::text,
      'capabilities', capabilities,
      'adapterType', adapter_type,
      'adapterConfig', adapter_config,
      'runtimeConfig', runtime_config,
      'permissions', permissions,
      'budgetMonthlyCents', budget_monthly_cents,
      'defaultEnvironmentId', default_environment_id::text,
      'metadata', metadata
    ) ORDER BY created_at)
    FROM agents
    WHERE company_id = (SELECT company_id FROM agents WHERE id = '{chief_id}'::uuid)
  ), '[]'::json),
  'keys', COALESCE((
    SELECT json_agg(json_build_object(
      'agentId', agent_id::text,
      'revoked', revoked_at IS NOT NULL
    ) ORDER BY created_at)
    FROM agent_api_keys
    WHERE agent_id IN ({specialist_sql})
  ), '[]'::json),
  'environments', COALESCE((
    SELECT json_agg(json_build_object(
      'id', id::text,
      'name', name,
      'driver', driver,
      'status', status,
      'config', config,
      'envVars', env_vars,
      'metadata', metadata
    ) ORDER BY created_at)
    FROM environments
    WHERE id IN ({environment_sql})
       OR metadata->'nix' = '{environment_marker}'::jsonb
  ), '[]'::json),
  'secrets', COALESCE((
    SELECT json_agg(json_build_object(
      'id', id::text,
      'companyId', company_id::text,
      'key', key,
      'status', status,
      'managedMode', managed_mode,
      'description', description,
      'deleted', deleted_at IS NOT NULL
    ) ORDER BY created_at)
    FROM company_secrets
    WHERE company_id = (SELECT company_id FROM agents WHERE id = '{chief_id}'::uuid)
      AND key IN ('nix-specialist-worker-ssh-key', 'nix-specialist-opencode-api-key')
  ), '[]'::json),
  'bindings', COALESCE((
    SELECT json_agg(json_build_object(
      'secretId', secret_id::text, 'targetType', target_type,
      'targetId', target_id, 'configPath', config_path,
      'versionSelector', version_selector, 'required', required
    ) ORDER BY config_path)
    FROM company_secret_bindings
    WHERE company_id = (SELECT company_id FROM agents WHERE id = '{chief_id}'::uuid)
      AND (
        (target_type = 'environment' AND target_id IN ({','.join(repr(value) for value in environment_ids.values())}))
        OR secret_id IN (
          SELECT id FROM company_secrets
          WHERE company_id = (SELECT company_id FROM agents WHERE id = '{chief_id}'::uuid)
            AND key IN ('nix-specialist-worker-ssh-key', 'nix-specialist-opencode-api-key')
        )
      )
  ), '[]'::json),
  'unsafeLeases', '[]'::json,
  'unsafeRuns', COALESCE((
    SELECT json_agg(json_build_object('id', id::text, 'status', status, 'agentId', agent_id::text))
    FROM heartbeat_runs
    WHERE agent_id IN ({specialist_sql})
      AND (status IS NULL OR status NOT IN ('succeeded', 'interrupted', 'failed', 'cancelled', 'timed_out'))
  ), '[]'::json),
  'plugins', '[]'::json,
  'experimental', COALESCE((
    SELECT experimental FROM instance_settings WHERE singleton_key = 'default'
  ), '{{}}'::jsonb),
  'markedSpecialistCount', (
    SELECT count(*) FROM agents
    WHERE company_id = (SELECT company_id FROM agents WHERE id = '{chief_id}'::uuid)
      AND metadata->'nix' = '{marker}'::jsonb
  )
)::text;
"""


def require_dict(value: object, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise TopologyError(f"{label} is invalid")
    return value


def is_engineering_manager(row: dict[str, Any]) -> bool:
    role = str(row.get("role") or "").lower().replace("-", "_")
    if role in {"engineering_manager", "eng_manager"}:
        return True
    for field in ("name", "title"):
        value = re.sub(r"[_-]+", " ", str(row.get(field) or "").lower())
        if re.search(r"\bengineering\s+manager\b", value):
            return True
    return False


def validate_topology(expected: dict[str, Any], snapshot: dict[str, Any]) -> None:
    chief_id = str(expected.get("chiefId") or "")
    project_id = str(expected.get("projectId") or "")
    environment_ids = expected.get("environmentIds")
    specialist_ids = expected.get("specialistIds")
    if not isinstance(specialist_ids, dict) or set(specialist_ids) != set(ROLE_SPECS):
        raise TopologyError("expected specialist identity map is invalid")
    if not isinstance(environment_ids, dict) or set(environment_ids) != set(ROLE_SPECS):
        raise TopologyError("expected specialist environment map is invalid")
    for label, value in {
        "Chief agent ID": chief_id,
        "approved project ID": project_id,
        **{f"{slug} environment ID": str(value) for slug, value in environment_ids.items()},
        **{f"{slug} agent ID": str(value) for slug, value in specialist_ids.items()},
    }.items():
        require_uuid(value, label)

    chief = require_dict(snapshot.get("chief"), "Chief snapshot")
    company_id = str(chief.get("companyId") or "")
    require_uuid(company_id, "Chief company ID")
    if (
        chief.get("id") != chief_id
        or chief.get("name") != "Chief of Staff"
        or chief.get("role") != "ceo"
        or chief.get("reportsTo") is not None
        or chief.get("status") in ("pending_approval", "terminated")
        or chief.get("adapterType") != "hermes_gateway"
    ):
        raise TopologyError("accepted Chief identity or adapter topology changed")
    chief_permissions = require_dict(chief.get("permissions"), "Chief permissions")
    if any(
        chief_permissions.get(key) is not value
        for key, value in (
            ("canCreateAgents", False),
            ("canCreateSkills", False),
            ("canAssignTasks", True),
        )
    ):
        raise TopologyError("accepted Chief permissions changed")

    project = require_dict(snapshot.get("project"), "approved project snapshot")
    if project.get("id") != project_id or project.get("companyId") != company_id:
        raise TopologyError("approved project is absent or belongs to another company")

    agents = snapshot.get("agents")
    keys = snapshot.get("keys")
    environments = snapshot.get("environments")
    secrets = snapshot.get("secrets")
    bindings = snapshot.get("bindings")
    unsafe_leases = snapshot.get("unsafeLeases")
    unsafe_runs = snapshot.get("unsafeRuns")
    plugins = snapshot.get("plugins")
    experimental = snapshot.get("experimental")
    if not all(isinstance(value, list) for value in (
        agents, keys, environments, secrets, bindings, unsafe_leases, unsafe_runs, plugins,
    )):
        raise TopologyError("specialist topology snapshot is invalid")
    if not isinstance(experimental, dict):
        raise TopologyError("instance experimental settings snapshot is invalid")
    if experimental.get("enableEnvironments") is not True or experimental.get("enableNativeRunner") is not True:
        raise TopologyError("Paperclip environments/native runner are not both enabled")
    if any(
        isinstance(row, dict)
        and row.get("status") != "terminated"
        and is_engineering_manager(row)
        for row in agents
    ):
        raise TopologyError("unexpected Engineering Manager exists")

    expected_id_set = {str(value) for value in specialist_ids.values()}
    if any(
        isinstance(row, dict)
        and row.get("status") != "terminated"
        and row.get("adapterType") == "paperclip_runner"
        and row.get("id") not in expected_id_set
        for row in agents
    ):
        raise TopologyError("unexpected nonterminated paperclip_runner exists outside the specialist allowlist")
    if unsafe_leases:
        raise TopologyError("nonterminal or unknown specialist run blocks a safe backup")
    if unsafe_runs:
        raise TopologyError("nonterminal or unknown specialist run blocks a safe backup")

    expected_id_list = [str(specialist_ids[slug]) for slug in ROLE_SPECS]
    marked = [
        row
        for row in agents
        if isinstance(row, dict)
        and isinstance(row.get("metadata"), dict)
        and row["metadata"].get("nix") == AGENT_MARKER
    ]
    if snapshot.get("markedSpecialistCount") != 3 or len(marked) != 3:
        raise TopologyError("exactly three marked task-scoped specialists are required")
    if {row.get("id") for row in marked} != set(expected_id_list):
        raise TopologyError("marked specialist identities do not match deployment configuration")

    permissions = expected_permissions(company_id, project_id, expected_id_list)
    for slug, (name, role) in ROLE_SPECS.items():
        agent_id = specialist_ids[slug]
        adapter_config = expected_adapter_config(company_id, agent_id)
        matches = [row for row in agents if isinstance(row, dict) and row.get("id") == agent_id]
        if len(matches) != 1:
            raise TopologyError(f"configured {slug} specialist is not unique")
        row = matches[0]
        metadata = require_dict(row.get("metadata"), f"{slug} metadata")
        if (
            row.get("companyId") != company_id
            or row.get("name") != name
            or row.get("role") != role
            or row.get("reportsTo") != chief_id
            or row.get("status") != "idle"
            or row.get("adapterType") != "paperclip_runner"
            or row.get("adapterConfig") != adapter_config
            or row.get("runtimeConfig") != {"heartbeat": {"enabled": False, "maxConcurrentRuns": 1}}
            or row.get("budgetMonthlyCents") != 0
            or row.get("defaultEnvironmentId") != environment_ids[slug]
            or metadata.get("nix") != AGENT_MARKER
            or metadata.get("specialistRole") != slug
        ):
            raise TopologyError(f"configured {slug} specialist topology is unsafe")
        if row.get("permissions") != permissions:
            raise TopologyError(f"configured {slug} specialist permissions are unsafe")
        same_name = [
            candidate
            for candidate in agents
            if isinstance(candidate, dict)
            and candidate.get("status") != "terminated"
            and candidate.get("name") == name
        ]
        if len(same_name) != 1:
            raise TopologyError(f"active {name} identity is not unique")

    if any(
        isinstance(row, dict)
        and row.get("agentId") in expected_id_list
        and row.get("revoked") is False
        for row in keys
    ):
        raise TopologyError("task-scoped specialist unexpectedly has an active API key")

    if len(environments) != 3:
        raise TopologyError("exactly three specialist SSH environments are required")
    known_hosts = str(expected.get("knownHosts") or "")
    environment_by_role: dict[str, dict[str, Any]] = {}
    provider_refs: set[str] = set()
    ssh_refs: set[str] = set()
    for raw_environment in environments:
        environment = require_dict(raw_environment, "specialist environment")
        metadata = require_dict(environment.get("metadata"), "specialist environment metadata")
        slug = str(metadata.get("specialistRole") or "")
        if slug not in ROLE_SPECS or slug in environment_by_role:
            raise TopologyError("specialist environment role mapping is unsafe")
        config = require_dict(environment.get("config"), "specialist environment config")
        env_vars = require_dict(environment.get("envVars"), "specialist environment variables")
        ssh_ref = config.get("privateKeySecretRef")
        provider_ref = env_vars.get("OPENCODE_API_KEY")
        expected_config = {
            "host": "specialist-worker", "port": 2222, "username": "worker",
            "remoteWorkspacePath": f"/workspaces/{slug}", "privateKey": None,
            "privateKeySecretRef": ssh_ref, "knownHosts": known_hosts,
            "strictHostKeyChecking": True,
        }
        if (
            environment.get("id") != environment_ids[slug]
            or environment.get("name") != f"Nix local specialist worker ({slug})"
            or environment.get("driver") != "ssh"
            or environment.get("status") != "active"
            or metadata.get("nix") != ENVIRONMENT_MARKER
            or config != expected_config
            or set(env_vars) != {"OPENCODE_API_KEY"}
            or not isinstance(ssh_ref, dict)
            or not isinstance(provider_ref, dict)
        ):
            raise TopologyError(f"specialist {slug} SSH environment configuration is unsafe")
        for ref in (ssh_ref, provider_ref):
            if ref.get("type") != "secret_ref" or ref.get("version") != "latest" \
                    or not UUID_RE.fullmatch(str(ref.get("secretId") or "")):
                raise TopologyError("specialist environment secret references are invalid")
        ssh_refs.add(str(ssh_ref["secretId"]))
        provider_refs.add(str(provider_ref["secretId"]))
        environment_by_role[slug] = environment
    if len(ssh_refs) != 1 or len(provider_refs) != 1:
        raise TopologyError("specialist environments must share exactly the two reviewed secrets")
    ssh_ref_id = next(iter(ssh_refs))
    provider_ref_id = next(iter(provider_refs))
    provider_ref = require_dict(
        require_dict(environment_by_role["product"].get("envVars"), "provider environment variables").get("OPENCODE_API_KEY"),
        "specialist provider secret reference",
    )
    if (
        set(provider_ref)
        != {
            "type",
            "secretId",
            "version",
            "projectionClass",
            "projectionAllowlistKey",
        }
        or provider_ref.get("type") != "secret_ref"
        or provider_ref.get("version") != "latest"
        or provider_ref.get("projectionClass") != "unclassified"
        or provider_ref.get("projectionAllowlistKey") is not None
        or not UUID_RE.fullmatch(str(provider_ref.get("secretId") or ""))
    ):
        raise TopologyError("specialist provider secret reference is unsafe")

    secret_by_key = {
        str(row.get("key")): row
        for row in secrets
        if isinstance(row, dict) and isinstance(row.get("key"), str)
    }
    if len(secrets) != 2 or set(secret_by_key) != {
        "nix-specialist-worker-ssh-key",
        "nix-specialist-opencode-api-key",
    }:
        raise TopologyError("specialist secret metadata is missing or duplicated")
    expected_refs = {
        "nix-specialist-worker-ssh-key": ssh_ref_id,
        "nix-specialist-opencode-api-key": provider_ref_id,
    }
    expected_bindings = {
        (ssh_ref_id, environment_id, "privateKeySecretRef", "latest", True)
        for environment_id in environment_ids.values()
    } | {
        (provider_ref_id, environment_id, "env.OPENCODE_API_KEY", "latest", True)
        for environment_id in environment_ids.values()
    }
    actual_bindings = {
        (
            str(row.get("secretId") or ""),
            str(row.get("targetId") or ""),
            str(row.get("configPath") or ""),
            str(row.get("versionSelector") or ""),
            row.get("required"),
        )
        for row in bindings if isinstance(row, dict)
        and row.get("targetType") == "environment"
        and row.get("targetId") in set(environment_ids.values())
    }
    if len(bindings) != 6 or actual_bindings != expected_bindings:
        raise TopologyError("specialist environment secret binding rows are unsafe")
    fingerprints = expected.get("secretFingerprints")
    if not isinstance(fingerprints, dict) or set(fingerprints) != set(expected_refs):
        raise TopologyError("expected specialist secret fingerprints are invalid")
    for key, secret_id in expected_refs.items():
        row = secret_by_key[key]
        kind = "worker-ssh" if key == "nix-specialist-worker-ssh-key" else "provider"
        fingerprint = str(fingerprints.get(key) or "")
        if (
            not re.fullmatch(r"[0-9a-f]{64}", fingerprint)
            or row.get("id") != secret_id
            or row.get("companyId") != company_id
            or row.get("status") != "active"
            or row.get("managedMode") != "paperclip_managed"
            or row.get("description") != f"Nix Slice 3 {kind}; sha256={fingerprint}"
            or row.get("deleted") is not False
        ):
            raise TopologyError(f"specialist secret metadata is unsafe for {key}")

    if plugins:
        raise TopologyError("specialist topology must not depend on a sandbox-provider plugin")


def run(command: list[str], *, label: str) -> str:
    try:
        result = subprocess.run(
            command,
            cwd=REPO_ROOT,
            text=True,
            capture_output=True,
            check=False,
        )
    except OSError:
        raise TopologyError(f"{label} could not be started") from None
    if result.returncode != 0:
        raise TopologyError(f"{label} failed")
    return result.stdout


def production_check(config_path: pathlib.Path) -> None:
    run(
        [str(REPO_ROOT / "scripts/check-paperclip-chief-topology"), str(config_path)],
        label="accepted Chief topology check",
    )
    chief_id = require_uuid(read_config(config_path, "NIX_CHIEF_AGENT_ID"), "Chief agent ID")
    project_id = require_uuid(
        read_config(config_path, "NIX_APPROVED_PROJECT_ID"), "approved project ID"
    )
    environment_ids = {
        slug: require_uuid(
            read_config(config_path, f"NIX_{slug.upper()}_ENVIRONMENT_ID"),
            f"{slug} environment ID",
        )
        for slug in ROLE_SPECS
    }
    if read_config(config_path, "NIX_SPECIALIST_ENVIRONMENT_IDS").split(",") != list(environment_ids.values()):
        raise TopologyError("NIX_SPECIALIST_ENVIRONMENT_IDS does not match the role environment IDs")
    specialist_ids = specialist_ids_from_config(config_path)
    provider_keys = read_provider_key_file(
        pathlib.Path(read_config(config_path, "SPECIALIST_PROVIDER_ENV_FILE"))
    )
    query = build_topology_query(chief_id, project_id, environment_ids, specialist_ids)
    compose = [
        "docker",
        "compose",
        "--project-directory",
        str(REPO_ROOT),
        "--file",
        str(REPO_ROOT / "compose.yaml"),
        "--env-file",
        str(config_path),
    ]
    output = run(
        [
            *compose,
            "exec",
            "-T",
            "postgres",
            "psql",
            "--username",
            "paperclip",
            "--dbname",
            "paperclip",
            "--no-psqlrc",
            "--tuples-only",
            "--no-align",
            "--command",
            query,
        ],
        label="Paperclip specialist topology query",
    ).strip()
    try:
        snapshot = json.loads(output)
    except json.JSONDecodeError:
        raise TopologyError("Paperclip specialist topology query returned invalid JSON") from None
    validate_topology(
        {
            "chiefId": chief_id,
            "projectId": project_id,
            "environmentIds": environment_ids,
            "specialistIds": specialist_ids,
            "knownHosts": f"[specialist-worker]:2222 {ssh_public_key(pathlib.Path(read_config(config_path, 'SPECIALIST_WORKER_HOST_KEY_FILE')), 'specialist worker host key')}",
            "secretFingerprints": {
                "nix-specialist-worker-ssh-key": hashlib.sha256(
                    read_locked_file(pathlib.Path(read_config(config_path, "SPECIALIST_WORKER_CLIENT_KEY_FILE")), "specialist worker client key").encode()
                ).hexdigest(),
                "nix-specialist-opencode-api-key": hashlib.sha256(
                    provider_keys["OPENCODE_API_KEY"].encode()
                ).hexdigest(),
            },
        },
        snapshot,
    )
    chief = require_dict(snapshot.get("chief"), "Chief snapshot")
    company_id = require_uuid(str(chief.get("companyId") or ""), "Chief company ID")
    verify_instruction_bundles(config_path, company_id, specialist_ids)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("config", type=pathlib.Path)
    args = parser.parse_args()
    try:
        production_check(args.config.resolve())
        print("Paperclip task-scoped specialist topology is safe.")
        return 0
    except (TopologyError, json.JSONDecodeError) as exc:
        print(f"Paperclip specialist topology error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
