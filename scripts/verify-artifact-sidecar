#!/usr/bin/env python3
"""Verify an artifact's exact adjacent SHA-256 sidecar without following paths."""

from __future__ import annotations

import hashlib
from pathlib import Path
import re
import sys


def main() -> int:
    if len(sys.argv) != 2:
        raise SystemExit("usage: verify-artifact-sidecar /absolute/path/to/artifact")
    artifact = Path(sys.argv[1])
    sidecar = Path(f"{artifact}.sha256")
    if not artifact.is_absolute() or not artifact.is_file() or artifact.is_symlink():
        raise SystemExit("artifact checksum error: artifact is missing or unsafe")
    if not sidecar.is_file() or sidecar.is_symlink():
        raise SystemExit("artifact checksum error: sidecar is missing or unsafe")
    lines = sidecar.read_text(encoding="utf-8").splitlines()
    if len(lines) != 1:
        raise SystemExit("artifact checksum error: sidecar must contain exactly one entry")
    match = re.fullmatch(r"([0-9a-f]{64}) [ *]([^/\\]+)", lines[0])
    if match is None or match.group(2) != artifact.name:
        raise SystemExit("artifact checksum error: sidecar does not name the exact artifact")
    digest = hashlib.sha256()
    with artifact.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    if digest.hexdigest() != match.group(1):
        raise SystemExit("artifact checksum error: checksum mismatch")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
