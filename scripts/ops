#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_file=${CONFIG_FILE:-$repo_root/.env}
action=${1:-}
compose=(docker compose --env-file "$config_file")

usage() {
  printf 'Usage: CONFIG_FILE=/path/to/.env %s {deploy|upgrade|bootstrap-ceo|status|health|logs|restart}\n' "$0" >&2
  exit 2
}

check_specialist_topology_when_configured() {
  local specialist_ids
  specialist_ids=$(grep -E '^NIX_SPECIALIST_AGENT_IDS=' "$config_file" | tail -n 1 | cut -d= -f2-)
  if [[ -n "$specialist_ids" ]]; then
    "$repo_root/scripts/check-paperclip-specialist-topology" "$config_file"
  fi
}

case "$action" in
  deploy)
    "$repo_root/scripts/check-config" "$config_file"
    "${compose[@]}" pull paperclip postgres hermes
    "${compose[@]}" build --pull specialist-worker
    "${compose[@]}" up -d --wait postgres
    "$repo_root/scripts/check-migrations" "$config_file"
    "$repo_root/scripts/initialize-paperclip" "$config_file"
    "$repo_root/scripts/check-migrations" "$config_file"
    "$repo_root/scripts/transition-paperclip" "$config_file"
    "${compose[@]}" up -d --wait paperclip hermes
    "${compose[@]}" exec -T paperclip curl -fsS http://127.0.0.1:3100/api/health
    "${compose[@]}" exec -T --user 10000:10000 hermes curl -fsS http://127.0.0.1:8642/health >/dev/null
    check_specialist_topology_when_configured
    printf '\nPaperclip and Hermes are healthy. Configure Tailscale Serve before checking tailnet health.\n'
    ;;
  upgrade)
    "$repo_root/scripts/check-config" "$config_file"
    specialist_ids=$(grep -E '^NIX_SPECIALIST_AGENT_IDS=' "$config_file" | tail -n 1 | cut -d= -f2-)
    if [[ -z "$specialist_ids" ]]; then
      NIX_BACKUP_PRE_SPECIALIST_TRANSITION=1 "$repo_root/scripts/backup" "$config_file"
    else
      "$repo_root/scripts/backup" "$config_file"
    fi
    "$repo_root/scripts/check-migrations" "$config_file"
    "${compose[@]}" pull paperclip postgres hermes
    "${compose[@]}" build --pull specialist-worker
    "${compose[@]}" up -d --wait --remove-orphans
    "$repo_root/scripts/configure-specialist-runner-route" converge "$config_file"
    "$0" health
    ;;
  bootstrap-ceo)
    "$repo_root/scripts/bootstrap-ceo" "$config_file"
    ;;
  status)
    "${compose[@]}" ps
    ;;
  health)
    "$repo_root/scripts/check-config" "$config_file"
    printf '%s\n' 'Internal Paperclip health:'
    "${compose[@]}" exec -T paperclip curl -fsS http://127.0.0.1:3100/api/health
    printf '\n%s\n' 'Tailnet health through Tailscale Serve:'
    public_url=$(grep -E '^PAPERCLIP_PUBLIC_URL=' "$config_file" | tail -n 1 | cut -d= -f2-)
    curl --fail --silent --show-error "${public_url}/api/health"
    printf '\n%s\n' 'Specialist runner tailnet route:'
    "$repo_root/scripts/configure-specialist-runner-route" verify-if-running "$config_file"
    printf '\n%s\n' 'Internal Hermes health and authenticated API boundary:'
    "$repo_root/scripts/configure-hermes" verify "$config_file"
    check_specialist_topology_when_configured
    ;;
  logs)
    "${compose[@]}" logs --follow --tail 200 hermes paperclip postgres specialist-worker
    ;;
  restart)
    "$repo_root/scripts/check-config" "$config_file"
    check_specialist_topology_when_configured
    "$repo_root/scripts/check-migrations" "$config_file"
    "${compose[@]}" build specialist-worker
    "${compose[@]}" up -d --force-recreate --wait
    "$repo_root/scripts/configure-specialist-runner-route" converge "$config_file"
    check_specialist_topology_when_configured
    ;;
  *) usage ;;
esac
