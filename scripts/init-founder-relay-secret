#!/usr/bin/env bash
set -euo pipefail
umask 077

config_file=${1:-${CONFIG_FILE:-.env}}

fail() {
  printf 'founder relay initialization error: %s\n' "$*" >&2
  exit 1
}

read_config() {
  local key=$1 value
  value=$(grep -E "^${key}=" "$config_file" | tail -n 1 | cut -d= -f2- || true)
  [[ -n "$value" ]] || fail "$key is missing or empty in $config_file"
  printf '%s' "$value"
}

read_secret() {
  local path=$1 key=$2 value count
  count=$(grep -Ec "^${key}=" "$path" || true)
  [[ "$count" == 1 ]] || fail "$path must contain exactly one $key binding"
  value=$(grep -E "^${key}=" "$path" | cut -d= -f2-)
  [[ -n "$value" ]] || fail "$key is empty in $path"
  printf '%s' "$value"
}

[[ $EUID == 0 ]] || fail 'run this helper as root'
[[ -f "$config_file" ]] || fail "$config_file does not exist"

hermes_env=$(read_config HERMES_ENV_FILE)
relay_env=$(read_config FOUNDER_RELAY_ENV_FILE)
[[ "$hermes_env" == /* && "$relay_env" == /* ]] || fail 'secret-file paths must be absolute'
[[ -f "$hermes_env" && ! -L "$hermes_env" ]] || fail 'Hermes secret file is missing or unsafe'
[[ $(stat -c '%a' "$hermes_env") == 600 && $(stat -c '%u' "$hermes_env") == 0 ]] \
  || fail 'Hermes secret file must be root-owned mode 0600'

telegram_user=$(read_secret "$hermes_env" TELEGRAM_ALLOWED_USERS)
telegram_chat=$(read_secret "$hermes_env" TELEGRAM_HOME_CHANNEL)
[[ "$telegram_user" =~ ^[0-9]+$ && "$telegram_user" == "$telegram_chat" ]] \
  || fail 'Hermes must be pinned to Lior single-user direct-message Telegram mode'

if [[ -e "$relay_env" || -L "$relay_env" ]]; then
  [[ -f "$relay_env" && ! -L "$relay_env" ]] || fail 'existing founder relay file is unsafe'
  [[ $(stat -c '%a' "$relay_env") == 600 && $(stat -c '%u' "$relay_env") == 0 ]] \
    || fail 'existing founder relay file must be root-owned mode 0600'
  relay_secret=$(read_secret "$relay_env" NIX_FOUNDER_RELAY_SECRET)
  stored_user=$(read_secret "$relay_env" NIX_LIOR_TELEGRAM_USER_ID)
  stored_chat=$(read_secret "$relay_env" NIX_LIOR_TELEGRAM_CHAT_ID)
  [[ "$relay_secret" =~ ^[0-9a-f]{64}$ ]] || fail 'existing founder relay secret is malformed'
  [[ "$stored_user" == "$telegram_user" && "$stored_chat" == "$telegram_chat" ]] \
    || fail 'existing founder relay identity differs from validated Hermes Telegram identity'
  printf 'Founder relay secret and Telegram identity already match the validated Hermes configuration.\n'
  exit 0
fi

install -d -m 0700 "$(dirname "$relay_env")"
temporary="${relay_env}.tmp.$$"
trap 'rm -f -- "$temporary"' EXIT
relay_secret=$(openssl rand -hex 32)
{
  printf 'NIX_FOUNDER_RELAY_SECRET=%s\n' "$relay_secret"
  printf 'NIX_LIOR_TELEGRAM_USER_ID=%s\n' "$telegram_user"
  printf 'NIX_LIOR_TELEGRAM_CHAT_ID=%s\n' "$telegram_chat"
} >"$temporary"
chmod 0600 "$temporary"
chown root:root "$temporary"
mv -n -- "$temporary" "$relay_env" || fail 'refusing to overwrite founder relay secret'
[[ ! -e "$temporary" ]] || fail 'founder relay destination appeared during creation; nothing was overwritten'
trap - EXIT
printf 'Created founder relay attestation configuration without printing secret or identity values.\n'
