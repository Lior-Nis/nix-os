#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
config_file=${1:-${CONFIG_FILE:-.env}}
pinned_hermes_gids="$repo_root/deploy/hermes/pinned-system-gids.txt"

fail() { printf 'Hermes secret initialization error: %s\n' "$*" >&2; exit 1; }
read_config() {
  local value
  value=$(grep -E "^${1}=" "$config_file" | tail -n 1 | cut -d= -f2- || true)
  [[ -n "$value" ]] || fail "$1 is missing or empty in $config_file"
  printf '%s' "$value"
}

validate_brain_group() {
  local brain_path brain_gid actual_gid brain_mode
  brain_path=$(read_config NIX_BRAIN_HOST_PATH)
  brain_gid=$(read_config NIX_BRAIN_GID)
  [[ "$brain_path" == /* && -d "$brain_path" && ! -L "$brain_path" ]] \
    || fail "NIX_BRAIN_HOST_PATH must name a real absolute directory, not a symlink"
  [[ "$brain_gid" =~ ^[1-9][0-9]*$ ]] \
    || fail "NIX_BRAIN_GID must be a positive numeric group ID"
  actual_gid=$(stat -c '%g' "$brain_path" 2>/dev/null || stat -f '%g' "$brain_path")
  [[ "$brain_gid" == "$actual_gid" ]] \
    || fail "NIX_BRAIN_GID must exactly match the group of NIX_BRAIN_HOST_PATH"
  brain_mode=$(stat -c '%a' "$brain_path" 2>/dev/null || stat -f '%Lp' "$brain_path")
  (( (8#$brain_mode & 050) == 050 )) \
    || fail "NIX_BRAIN_HOST_PATH must grant its group read and traverse permissions"
  (( (8#$brain_mode & 007) == 0 )) \
    || fail "NIX_BRAIN_HOST_PATH must not grant permissions to other users"
  [[ -f "$pinned_hermes_gids" ]] || fail "pinned Hermes system-group inventory is missing"
  if [[ "$brain_gid" != 10000 ]] && grep -qx "$brain_gid" "$pinned_hermes_gids"; then
    fail "NIX_BRAIN_GID collides with a group in the pinned Hermes image"
  fi
}

command -v openssl >/dev/null 2>&1 || fail "openssl is required"
[[ -f "$config_file" ]] || fail "$config_file does not exist"
validate_brain_group
hermes_env=$(read_config HERMES_ENV_FILE)
hermes_mode_file=$(read_config HERMES_TELEGRAM_MODE_FILE)
[[ "$hermes_env" == /* ]] || fail "HERMES_ENV_FILE must be absolute"
[[ "$hermes_mode_file" == /* ]] || fail "HERMES_TELEGRAM_MODE_FILE must be absolute"
[[ ! -e "$hermes_env" ]] || fail "refusing to overwrite existing secret file: $hermes_env"
[[ ! -e "$hermes_mode_file" ]] || fail "refusing to overwrite existing Telegram mode marker: $hermes_mode_file"

install -d -m 0700 "$(dirname "$hermes_env")"
api_server_key=$(openssl rand -hex 32)
decision_webhook_secret=$(openssl rand -hex 32)
cat >"$hermes_env" <<EOF
API_SERVER_KEY=$api_server_key
HERMES_DECISION_WEBHOOK_SECRET=$decision_webhook_secret
WEBHOOK_SECRET=$decision_webhook_secret
OPENCODE_GO_API_KEY=REPLACE_WITH_OPENCODE_GO_API_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_LIOR_NUMERIC_USER_ID
TELEGRAM_HOME_CHANNEL=REPLACE_WITH_LIOR_NUMERIC_USER_ID
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
EOF
chmod 0600 "$hermes_env"
install -d -m 0700 "$(dirname "$hermes_mode_file")"
printf 'HERMES_TELEGRAM_MODE=disabled\n' >"$hermes_mode_file"
chmod 0600 "$hermes_mode_file"
printf 'Created %s with a generated API server key and provider/Telegram onboarding placeholders.\n' "$hermes_env"
printf 'Created %s in fail-closed disabled mode.\n' "$hermes_mode_file"
printf 'Fill the placeholders locally; do not paste their values into chat or logs.\n'
