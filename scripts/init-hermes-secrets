#!/usr/bin/env bash
set -euo pipefail
umask 077

config_file=${1:-${CONFIG_FILE:-.env}}

fail() { printf 'Hermes secret initialization error: %s\n' "$*" >&2; exit 1; }
read_config() {
  local value
  value=$(grep -E "^${1}=" "$config_file" | tail -n 1 | cut -d= -f2- || true)
  [[ -n "$value" ]] || fail "$1 is missing or empty in $config_file"
  printf '%s' "$value"
}

command -v openssl >/dev/null 2>&1 || fail "openssl is required"
[[ -f "$config_file" ]] || fail "$config_file does not exist"
hermes_env=$(read_config HERMES_ENV_FILE)
hermes_mode_file=$(read_config HERMES_TELEGRAM_MODE_FILE)
[[ "$hermes_env" == /* ]] || fail "HERMES_ENV_FILE must be absolute"
[[ "$hermes_mode_file" == /* ]] || fail "HERMES_TELEGRAM_MODE_FILE must be absolute"
[[ ! -e "$hermes_env" ]] || fail "refusing to overwrite existing secret file: $hermes_env"
[[ ! -e "$hermes_mode_file" ]] || fail "refusing to overwrite existing Telegram mode marker: $hermes_mode_file"

install -d -m 0700 "$(dirname "$hermes_env")"
api_server_key=$(openssl rand -hex 32)
cat >"$hermes_env" <<EOF
API_SERVER_KEY=$api_server_key
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_LIOR_NUMERIC_USER_ID
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
EOF
chmod 0600 "$hermes_env"
install -d -m 0700 "$(dirname "$hermes_mode_file")"
printf 'HERMES_TELEGRAM_MODE=disabled\n' >"$hermes_mode_file"
chmod 0600 "$hermes_mode_file"
printf 'Created %s with a generated API server key and Telegram onboarding placeholders.\n' "$hermes_env"
printf 'Created %s in fail-closed disabled mode.\n' "$hermes_mode_file"
printf 'Fill the placeholders locally; do not paste their values into chat or logs.\n'
