#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

for shell_file in \
  deploy/postgres/10-paperclip.sh \
  scripts/backup-config \
  scripts/check-config \
  scripts/check-migrations \
  scripts/configure-tailscale \
  scripts/bootstrap-ceo \
  scripts/init-secrets \
  scripts/initialize-paperclip \
  scripts/ops \
  scripts/backup \
  scripts/restore-config \
  scripts/restore-smoke \
  scripts/vps-preflight \
  scripts/ci \
  tests/smoke/foundation.sh \
  tests/smoke/backup-restore.sh \
  tests/smoke/config-backup.sh \
  tests/smoke/tailscale-serve-policy.sh; do
  bash -n "$shell_file"
done

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck deploy/postgres/10-paperclip.sh scripts/backup-config scripts/bootstrap-ceo scripts/check-config scripts/check-migrations scripts/configure-tailscale scripts/init-secrets scripts/initialize-paperclip scripts/ops scripts/backup scripts/restore-config scripts/restore-smoke scripts/vps-preflight scripts/ci tests/smoke/foundation.sh tests/smoke/backup-restore.sh tests/smoke/config-backup.sh
elif [[ ${REQUIRE_SHELLCHECK:-0} == 1 ]]; then
  printf 'shellcheck is required but not installed\n' >&2
  exit 1
else
  printf 'shellcheck not installed; bash syntax checks still ran\n' >&2
fi

tests/smoke/tailscale-serve-policy.sh
tests/smoke/foundation.sh
tests/smoke/config-backup.sh

if [[ ${RUN_DOCKER_SMOKE:-0} == 1 ]]; then
  tests/smoke/backup-restore.sh
fi
