#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

for shell_file in \
  deploy/postgres/10-paperclip.sh \
  scripts/backup-config \
  scripts/check-config \
  scripts/check-migrations \
  scripts/bootstrap-ceo \
  scripts/init-secrets \
  scripts/initialize-paperclip \
  scripts/ops \
  scripts/backup \
  scripts/restore-config \
  scripts/restore-smoke \
  scripts/vps-preflight \
  scripts/ci \
  tests/smoke/foundation.sh \
  tests/smoke/backup-restore.sh \
  tests/smoke/config-backup.sh; do
  bash -n "$shell_file"
done

if command -v shellcheck >/dev/null 2>&1; then
  shellcheck deploy/postgres/10-paperclip.sh scripts/backup-config scripts/bootstrap-ceo scripts/check-config scripts/check-migrations scripts/init-secrets scripts/initialize-paperclip scripts/ops scripts/backup scripts/restore-config scripts/restore-smoke scripts/vps-preflight scripts/ci tests/smoke/foundation.sh tests/smoke/backup-restore.sh tests/smoke/config-backup.sh
elif [[ ${REQUIRE_SHELLCHECK:-0} == 1 ]]; then
  printf 'shellcheck is required but not installed\n' >&2
  exit 1
else
  printf 'shellcheck not installed; bash syntax checks still ran\n' >&2
fi

tests/smoke/foundation.sh
tests/smoke/config-backup.sh
docker run --rm \
  --env PAPERCLIP_HOSTNAME=paperclip.test \
  --env ACME_EMAIL=operator@test.invalid \
  --volume "$repo_root/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro" \
  caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b \
  caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

if [[ ${RUN_DOCKER_SMOKE:-0} == 1 ]]; then
  tests/smoke/backup-restore.sh
fi
