#!/usr/bin/env bash
set -euo pipefail
umask 077

config_file=${1:-${CONFIG_FILE:-.env}}

fail() {
  printf 'secret initialization error: %s\n' "$*" >&2
  exit 1
}

read_config() {
  local key=$1
  local value
  value=$(grep -E "^${key}=" "$config_file" | tail -n 1 | cut -d= -f2- || true)
  [[ -n "$value" ]] || fail "$key is missing or empty in $config_file"
  printf '%s' "$value"
}

command -v openssl >/dev/null 2>&1 || fail "openssl is required"
[[ -f "$config_file" ]] || fail "$config_file does not exist"

postgres_env=$(read_config POSTGRES_ENV_FILE)
paperclip_env=$(read_config PAPERCLIP_ENV_FILE)
hermes_env=$(read_config HERMES_ENV_FILE)
for secret_file in "$postgres_env" "$paperclip_env" "$hermes_env"; do
  [[ "$secret_file" == /* ]] || fail "secret file paths must be absolute: $secret_file"
  [[ ! -e "$secret_file" ]] || fail "refusing to overwrite existing secret file: $secret_file"
done

install -d -m 0700 "$(dirname "$postgres_env")" "$(dirname "$paperclip_env")"
postgres_password=$(openssl rand -hex 32)
paperclip_db_password=$(openssl rand -hex 32)
better_auth_secret=$(openssl rand -hex 32)
tool_action_secret=$(openssl rand -hex 32)
api_server_key=$(openssl rand -hex 32)

printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password" >"$postgres_env"
printf 'PAPERCLIP_DB_PASSWORD=%s\n' "$paperclip_db_password" >>"$postgres_env"
printf 'DATABASE_URL=postgresql://paperclip:%s@postgres:5432/paperclip\n' "$paperclip_db_password" >"$paperclip_env"
printf 'BETTER_AUTH_SECRET=%s\n' "$better_auth_secret" >>"$paperclip_env"
printf 'PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=%s\n' "$tool_action_secret" >>"$paperclip_env"
chmod 0600 "$postgres_env" "$paperclip_env"

cat >"$hermes_env" <<EOF
API_SERVER_KEY=$api_server_key
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_ALLOWED_USERS=REPLACE_WITH_LIOR_NUMERIC_USER_ID
TELEGRAM_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
EOF
chmod 0600 "$hermes_env"

printf 'Created root-private secret files:\n  %s\n  %s\n  %s\n' "$postgres_env" "$paperclip_env" "$hermes_env"
printf 'Replace the two Telegram placeholders before deployment; do not paste their values into chat.\n'
printf 'Back them up separately in encrypted storage; they are not included in Git.\n'
