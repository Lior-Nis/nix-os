#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
artifact=${1:-}
archive_helper_image='postgres:17.11-alpine3.24@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24'
restore_tmp_dir=''
restore_started=0

fail() {
  printf 'restore smoke error: %s\n' "$*" >&2
  exit 1
}

read_config_value() {
  grep -E "^${1}=" "$restore_config" | tail -n 1 | cut -d= -f2- || true
}

cookie_header_from_file() {
  python3 - "$1" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
parts = []
for raw in path.read_text(encoding="utf-8").splitlines():
    if raw.startswith("#HttpOnly_"):
        raw = raw.removeprefix("#HttpOnly_")
    elif not raw or raw.startswith("#"):
        continue
    fields = raw.split("\t")
    if len(fields) != 7:
        raise SystemExit("restore cookie file is not a Netscape cookie jar")
    name, value = fields[5:7]
    if not re.fullmatch(r"[!#$%&'*+.^_`|~0-9A-Za-z-]+", name):
        raise SystemExit("restore cookie file contains an invalid cookie name")
    if any(character in value for character in '\\"\r\n;'):
        raise SystemExit("restore cookie file contains an unsafe cookie value")
    parts.append(f"{name}={value}")
if not parts:
    raise SystemExit("restore cookie file contains no cookies")
print("; ".join(parts))
PY
}

restore_board_request() {
  local method=$1 path=$2 body=${3:-} cookie_header
  cookie_header=$(cookie_header_from_file "$RESTORE_PAPERCLIP_COOKIE_FILE") \
    || fail "restored specialist probe cookie file is invalid"
  {
    printf 'silent\nshow-error\nfail\n'
    printf 'header = "Cookie: %s"\n' "$cookie_header"
    printf 'header = "Origin: https://nix-os.restore-test.ts.net"\n'
    if [[ "$method" == POST ]]; then
      printf 'header = "Content-Type: application/json"\n'
      printf 'request = "POST"\n'
      printf 'data = "%s"\n' "$body"
    fi
    printf 'url = "http://127.0.0.1:3100%s"\n' "$path"
  } | "${compose_restore[@]}" exec -T paperclip curl -K -
}

cleanup() {
  if [[ $restore_started == 1 && ${RESTORE_KEEP:-false} != true ]]; then
    docker compose --env-file "$restore_config" down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
  if [[ ${RESTORE_KEEP:-false} != true && -n "$restore_tmp_dir" ]]; then
    rm -rf "$restore_tmp_dir"
  fi
}
trap cleanup EXIT

[[ -n "$artifact" ]] || fail "usage: $0 /absolute/path/to/backup.tar.gz[.age]"
[[ "$artifact" == /* ]] || fail "backup artifact path must be absolute"
[[ -f "$artifact" ]] || fail "backup artifact does not exist: $artifact"
command -v python3 >/dev/null 2>&1 || fail "python3 is required"

"$repo_root/scripts/verify-artifact-sidecar" "$artifact"

if [[ -n ${RESTORE_WORK_DIR:-} ]]; then
  [[ ! -e "$RESTORE_WORK_DIR" ]] || fail "RESTORE_WORK_DIR already exists: $RESTORE_WORK_DIR"
  mkdir -p "$RESTORE_WORK_DIR"
  restore_tmp_dir=$RESTORE_WORK_DIR
else
  restore_tmp_dir=$(mktemp -d /tmp/nix-os-restore.XXXXXX)
fi
archive="$artifact"
if [[ "$artifact" == *.age ]]; then
  command -v age >/dev/null 2>&1 || fail "age is required to decrypt $artifact"
  [[ -n ${AGE_IDENTITY_FILE:-} ]] || fail "set AGE_IDENTITY_FILE to decrypt the backup"
  archive="$restore_tmp_dir/backup.tar.gz"
  age --decrypt --identity "$AGE_IDENTITY_FILE" --output "$archive" "$artifact"
fi

"$repo_root/scripts/safe-extract-tar" --required-prefix nix-os- "$archive" "$restore_tmp_dir"
payload_dir=$(find "$restore_tmp_dir" -mindepth 1 -maxdepth 1 -type d -name 'nix-os-*' -print)
[[ -n "$payload_dir" && "$payload_dir" != *$'\n'* ]] \
  || fail "backup must contain exactly one payload directory"
"$repo_root/scripts/verify-backup-checksums" "$payload_dir"
"$repo_root/scripts/safe-extract-tar" --validate-only --allow-dot-root "$payload_dir/paperclip-data.tar.gz"
"$repo_root/scripts/safe-extract-tar" --validate-only --allow-dot-root "$payload_dir/hermes-data.tar.gz"

backup_format=$(grep -E '^BACKUP_FORMAT_VERSION=' "$payload_dir/manifest.env" | cut -d= -f2- || true)
source_project=$(grep -E '^SOURCE_PROJECT=' "$payload_dir/manifest.env" | cut -d= -f2-)
case "$backup_format" in
  3)
    source_lior_user_id=$(grep -E '^PAPERCLIP_LIOR_USER_ID=' "$payload_dir/manifest.env" | cut -d= -f2- || true)
    ;;
  2)
    source_lior_user_id=${RESTORE_PAPERCLIP_LIOR_USER_ID:-}
    [[ -n "$source_lior_user_id" ]] \
      || fail "format-2 backup requires RESTORE_PAPERCLIP_LIOR_USER_ID from its external configuration pack"
    ;;
  *)
    fail "unsupported BACKUP_FORMAT_VERSION: ${backup_format:-missing}"
    ;;
esac
[[ "$source_lior_user_id" =~ ^[A-Za-z0-9._:-]{3,200}$ ]] \
  || fail "backup manifest has an invalid PAPERCLIP_LIOR_USER_ID"
restore_require_specialist_topology=${RESTORE_REQUIRE_SPECIALIST_TOPOLOGY:-true}
[[ "$restore_require_specialist_topology" == true || "$restore_require_specialist_topology" == false ]] \
  || fail "RESTORE_REQUIRE_SPECIALIST_TOPOLOGY must be true or false"
if [[ "$restore_require_specialist_topology" == true ]]; then
  [[ -n ${RESTORE_PAPERCLIP_COOKIE_FILE:-} \
    && -f "$RESTORE_PAPERCLIP_COOKIE_FILE" \
    && ! -L "$RESTORE_PAPERCLIP_COOKIE_FILE" ]] \
    || fail "RESTORE_PAPERCLIP_COOKIE_FILE must name a private authenticated board cookie jar"
  cookie_mode=$(stat -c '%a' "$RESTORE_PAPERCLIP_COOKIE_FILE" 2>/dev/null \
    || stat -f '%Lp' "$RESTORE_PAPERCLIP_COOKIE_FILE")
  (( (8#$cookie_mode & 077) == 0 )) \
    || fail "RESTORE_PAPERCLIP_COOKIE_FILE must not be group/world accessible"
  [[ $(stat -c '%h' "$RESTORE_PAPERCLIP_COOKIE_FILE" 2>/dev/null \
    || stat -f '%l' "$RESTORE_PAPERCLIP_COOKIE_FILE") == 1 ]] \
    || fail "RESTORE_PAPERCLIP_COOKIE_FILE must have exactly one hard link"
fi
restore_project=${RESTORE_PROJECT_NAME:-nix-os-restore-$$}
[[ "$restore_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "invalid RESTORE_PROJECT_NAME"
[[ "$restore_project" != "$source_project" ]] || fail "restore project must differ from source project"
[[ "$restore_project" != nix-os ]] || fail "refusing to use the production project name"

restore_postgres_volume="${restore_project}_postgres_data"
restore_paperclip_volume="${restore_project}_paperclip_data"
restore_hermes_volume="${restore_project}_hermes_data"
restore_runner_cache_volume="${restore_project}_paperclip_runner_cache"
for restore_volume in \
  "$restore_postgres_volume" \
  "$restore_paperclip_volume" \
  "$restore_hermes_volume" \
  "$restore_runner_cache_volume"; do
  if docker volume inspect "$restore_volume" >/dev/null 2>&1; then
    fail "restore target volume already exists: $restore_volume"
  fi
done

restore_postgres_env="$restore_tmp_dir/postgres.env"
restore_paperclip_env="$restore_tmp_dir/paperclip.env"
restore_hermes_env="$restore_tmp_dir/hermes.env"
restore_founder_relay_env="$restore_tmp_dir/founder-relay.env"
restore_specialist_provider_env="$restore_tmp_dir/specialist-provider.env"
restore_hermes_mode="$restore_tmp_dir/hermes-telegram-mode.env"
restore_brain="$restore_tmp_dir/nix-brain"
restore_config="$restore_tmp_dir/restore.env"
if [[ \
  -n ${RESTORE_POSTGRES_ENV_FILE:-} \
  || -n ${RESTORE_PAPERCLIP_ENV_FILE:-} \
  || -n ${RESTORE_HERMES_ENV_FILE:-} \
  || -n ${RESTORE_FOUNDER_RELAY_ENV_FILE:-} \
  || -n ${RESTORE_SPECIALIST_PROVIDER_ENV_FILE:-} \
]]; then
  [[ -n ${RESTORE_POSTGRES_ENV_FILE:-} && -f "$RESTORE_POSTGRES_ENV_FILE" ]] \
    || fail "RESTORE_POSTGRES_ENV_FILE must name the restored PostgreSQL secret file"
  [[ -n ${RESTORE_PAPERCLIP_ENV_FILE:-} && -f "$RESTORE_PAPERCLIP_ENV_FILE" ]] \
    || fail "RESTORE_PAPERCLIP_ENV_FILE must name the restored Paperclip secret file"
  [[ -n ${RESTORE_HERMES_ENV_FILE:-} && -f "$RESTORE_HERMES_ENV_FILE" ]] \
    || fail "RESTORE_HERMES_ENV_FILE must name the restored Hermes secret file"
  [[ -n ${RESTORE_FOUNDER_RELAY_ENV_FILE:-} && -f "$RESTORE_FOUNDER_RELAY_ENV_FILE" ]] \
    || fail "RESTORE_FOUNDER_RELAY_ENV_FILE must name the restored founder relay file"
  [[ -n ${RESTORE_SPECIALIST_PROVIDER_ENV_FILE:-} && -f "$RESTORE_SPECIALIST_PROVIDER_ENV_FILE" ]] \
    || fail "RESTORE_SPECIALIST_PROVIDER_ENV_FILE must name the restored provider import file"
  install -m 0600 "$RESTORE_POSTGRES_ENV_FILE" "$restore_postgres_env"
  install -m 0600 "$RESTORE_PAPERCLIP_ENV_FILE" "$restore_paperclip_env"
  install -m 0600 "$RESTORE_HERMES_ENV_FILE" "$restore_hermes_env"
  install -m 0600 "$RESTORE_FOUNDER_RELAY_ENV_FILE" "$restore_founder_relay_env"
  install -m 0600 "$RESTORE_SPECIALIST_PROVIDER_ENV_FILE" "$restore_specialist_provider_env"
else
  postgres_password=$(openssl rand -hex 32)
  paperclip_db_password=$(openssl rand -hex 32)
  better_auth_secret=$(openssl rand -hex 32)
  tool_action_secret=$(openssl rand -hex 32)
  printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password" >"$restore_postgres_env"
  printf 'PAPERCLIP_DB_PASSWORD=%s\n' "$paperclip_db_password" >>"$restore_postgres_env"
  {
    printf 'DATABASE_URL=postgresql://paperclip:%s@postgres:5432/paperclip\n' "$paperclip_db_password"
    printf 'BETTER_AUTH_SECRET=%s\n' "$better_auth_secret"
    printf 'PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=%s\n' "$tool_action_secret"
  } >"$restore_paperclip_env"
  {
    printf 'API_SERVER_KEY=%s\n' "$(openssl rand -hex 32)"
    decision_webhook_secret=$(openssl rand -hex 32)
    printf 'HERMES_DECISION_WEBHOOK_SECRET=%s\n' "$decision_webhook_secret"
    printf 'WEBHOOK_SECRET=%s\n' "$decision_webhook_secret"
    printf 'OPENCODE_GO_API_KEY=test-opencode-go-key-12345678\n'
    printf 'TELEGRAM_BOT_TOKEN=test-token\n'
    printf 'TELEGRAM_ALLOWED_USERS=123456789\n'
    printf 'TELEGRAM_HOME_CHANNEL=123456789\n'
    printf 'TELEGRAM_ALLOW_ALL_USERS=false\nGATEWAY_ALLOW_ALL_USERS=false\n'
  } >"$restore_hermes_env"
  printf 'NIX_FOUNDER_RELAY_SECRET=%s\n' "$(openssl rand -hex 32)" >"$restore_founder_relay_env"
  printf 'NIX_LIOR_TELEGRAM_USER_ID=123456789\nNIX_LIOR_TELEGRAM_CHAT_ID=123456789\n' \
    >>"$restore_founder_relay_env"
  {
    printf 'DAYTONA_API_KEY=test-daytona-key-1234567890\n'
    printf 'OPENCODE_API_KEY=test-restricted-opencode-key-12345678\n'
  } >"$restore_specialist_provider_env"
fi
mkdir -p "$restore_brain"
printf '# Isolated restore brain fixture\n' >"$restore_brain/README.md"
git -C "$restore_brain" init -q
git -C "$restore_brain" add README.md
restore_brain_gid=$("$repo_root/tests/fixtures/select-brain-gid")
chgrp -R "$restore_brain_gid" "$restore_brain"
chmod -R g+rX,o-rwx "$restore_brain"
restore_brain_gid=$(stat -c '%g' "$restore_brain" 2>/dev/null || stat -f '%g' "$restore_brain")
{
  printf 'COMPOSE_PROJECT_NAME=%s\n' "$restore_project"
  printf 'PAPERCLIP_PUBLIC_URL=https://nix-os.restore-test.ts.net\n'
  printf 'PAPERCLIP_LIOR_USER_ID=%s\n' "$source_lior_user_id"
  printf 'PAPERCLIP_HOST_PORT=0\n'
  printf 'POSTGRES_ENV_FILE=%s\n' "$restore_postgres_env"
  printf 'PAPERCLIP_ENV_FILE=%s\n' "$restore_paperclip_env"
  printf 'HERMES_ENV_FILE=%s\n' "$restore_hermes_env"
  printf 'FOUNDER_RELAY_ENV_FILE=%s\n' "$restore_founder_relay_env"
  printf 'HERMES_TELEGRAM_BOT_USERNAME=the_nixos_bot\n'
  printf 'HERMES_TELEGRAM_MODE_FILE=%s\n' "$restore_hermes_mode"
  printf 'SPECIALIST_PROVIDER_ENV_FILE=%s\n' "$restore_specialist_provider_env"
  printf 'NIX_CHIEF_AGENT_ID=%s\n' "${RESTORE_NIX_CHIEF_AGENT_ID:-11111111-1111-4111-8111-111111111111}"
  printf 'NIX_APPROVED_PROJECT_ID=%s\n' "${RESTORE_NIX_APPROVED_PROJECT_ID:-22222222-2222-4222-8222-222222222222}"
  printf 'NIX_PRODUCT_AGENT_ID=%s\n' "${RESTORE_NIX_PRODUCT_AGENT_ID:-33333333-3333-4333-8333-333333333333}"
  printf 'NIX_GROWTH_AGENT_ID=%s\n' "${RESTORE_NIX_GROWTH_AGENT_ID:-44444444-4444-4444-8444-444444444444}"
  printf 'NIX_OPERATIONS_AGENT_ID=%s\n' "${RESTORE_NIX_OPERATIONS_AGENT_ID:-55555555-5555-4555-8555-555555555555}"
  printf 'NIX_SPECIALIST_AGENT_IDS=%s\n' "${RESTORE_NIX_SPECIALIST_AGENT_IDS:-33333333-3333-4333-8333-333333333333,44444444-4444-4444-8444-444444444444,55555555-5555-4555-8555-555555555555}"
  printf 'NIX_SPECIALIST_ENVIRONMENT_ID=%s\n' "${RESTORE_NIX_SPECIALIST_ENVIRONMENT_ID:-66666666-6666-4666-8666-666666666666}"
  printf 'NIX_BRAIN_HOST_PATH=%s\n' "$restore_brain"
  printf 'NIX_BRAIN_GID=%s\n' "$restore_brain_gid"
  printf 'PAPERCLIP_AUTH_DISABLE_SIGN_UP=true\n'
  printf 'BACKUP_OUTPUT_DIR=%s\n' "$restore_tmp_dir/backups"
} >"$restore_config"
chmod 0600 \
  "$restore_postgres_env" \
  "$restore_paperclip_env" \
  "$restore_hermes_env" \
  "$restore_founder_relay_env" \
  "$restore_specialist_provider_env" \
  "$restore_config"
printf 'HERMES_TELEGRAM_MODE=disabled\n' >"$restore_hermes_mode"
chmod 0600 "$restore_hermes_mode"
NIX_ALLOW_TEST_CONFIG=1 "$repo_root/scripts/check-config" "$restore_config" >/dev/null

compose_restore=(docker compose -f "$repo_root/compose.yaml" --env-file "$restore_config")
"${compose_restore[@]}" create postgres paperclip hermes >/dev/null
restore_started=1
docker run --rm \
  --volume "$restore_paperclip_volume:/target" \
  --volume "$payload_dir:/backup:ro" \
  "$archive_helper_image" sh -ec 'find /target -mindepth 1 -delete && cd /target && tar -xzf /backup/paperclip-data.tar.gz'

docker run --rm \
  --volume "$restore_paperclip_volume:/source:ro" \
  --volume "$restore_tmp_dir:/verify" \
  "$archive_helper_image" sh -ec 'cd /source && find . -type f -exec sha256sum {} \; | sort > /verify/restored-paperclip-files.sha256'
diff -u "$payload_dir/paperclip-files.sha256" "$restore_tmp_dir/restored-paperclip-files.sha256"

docker run --rm \
  --volume "$restore_hermes_volume:/target" \
  --volume "$payload_dir:/backup:ro" \
  "$archive_helper_image" sh -ec 'find /target -mindepth 1 -delete && cd /target && tar -xzf /backup/hermes-data.tar.gz'
docker run --rm \
  --volume "$restore_hermes_volume:/state:ro" \
  --volume "$payload_dir:/backup:ro" \
  "$archive_helper_image" sh -ec '
  for path in .env .paperclip-claim-receipt.json; do
    test -f "/state/$path"
    test "$(stat -c %u:%g "/state/$path")" = 10000:10000
    test "$(stat -c %a "/state/$path")" = 600
  done
  if test -e /state/auth.json; then
    test -f /state/auth.json
    test "$(stat -c %u:%g /state/auth.json)" = 10000:10000
    test "$(stat -c %a /state/auth.json)" = 600
  fi
  for path in runs_idempotency.db state/paperclip-question-delivery.db; do
    test ! -L "/state/$path"
    if grep -Fq "  ./$path" /backup/hermes-files.sha256; then
      test -f "/state/$path"
      test "$(stat -c %h "/state/$path")" = 1
      test "$(stat -c %u:%g "/state/$path")" = 10000:10000
      test "$(stat -c %a "/state/$path")" = 600
    fi
  done
  test "$(find /state -maxdepth 1 -name ".paperclip-claim-*.pending" | wc -l | tr -d " ")" = 0
  test ! -e /state/mcp-tokens/nix-os-paperclip-claim-stage.json
' || fail "restored Hermes credentials/auth/claim receipt metadata is unsafe"
docker run --rm \
  --volume "$restore_hermes_volume:/source:ro" \
  --volume "$restore_tmp_dir:/verify" \
  "$archive_helper_image" sh -ec 'cd /source && find . -type f -exec sha256sum {} \; | sort > /verify/restored-hermes-files.sha256'
diff -u "$payload_dir/hermes-files.sha256" "$restore_tmp_dir/restored-hermes-files.sha256"

if [[ ${NIX_RESTORE_INJECT_PROFILE_TELEGRAM_CANARY:-0} == 1 ]]; then
  docker run --rm --user 10000:10000 --volume "$restore_hermes_volume:/state" "$archive_helper_image" sh -ec '
    existing=$(mktemp)
    cp /state/.env "$existing"
    printf "\357\273\277%s\n" "TELEGRAM_BOT_TOKEN=restored-profile-token-must-not-poll" > /state/.env
    printf "%s\n" \
      "'TELEGRAM_ALLOWED_USERS'=999999999" \
      "TELEGRAM_HOME_CHANNEL=999999999" \
      "PAPERCLIP_LIOR_USER_ID=profile-user-must-not-override" \
      "HERMES_DECISION_WEBHOOK_SECRET=profile-secret-must-not-override" \
      "WEBHOOK_SECRET=profile-secret-must-not-override" \
      "TELEGRAM_ALLOW_ALL_USERS=true" \
      "GATEWAY_ALLOW_ALL_USERS=true" >> /state/.env
    cat "$existing" >> /state/.env
    rm -f "$existing"
  '
fi

"${compose_restore[@]}" up -d --wait postgres
"${compose_restore[@]}" exec -T postgres pg_restore \
  --username paperclip \
  --dbname paperclip \
  --clean \
  --if-exists \
  --no-owner \
  --no-privileges <"$payload_dir/postgres.dump"

"$repo_root/scripts/check-paperclip-chief-topology" "$restore_config" >/dev/null \
  || fail "restored Paperclip Chief topology is unsafe"
if [[ "$restore_require_specialist_topology" == true ]]; then
  "$repo_root/scripts/check-paperclip-specialist-topology" "$restore_config" >/dev/null \
    || fail "restored Paperclip specialist topology is unsafe"
fi

"${compose_restore[@]}" exec -T postgres psql --username paperclip --dbname paperclip --tuples-only --no-align \
  --command "SELECT 'public_tables=' || count(*) FROM information_schema.tables WHERE table_schema = 'public'; SELECT 'companies=' || count(*) FROM companies; SELECT 'issues=' || count(*) FROM issues; SELECT 'documents=' || count(*) FROM documents;" \
  >"$restore_tmp_dir/restored-database-counts.txt"
diff -u "$payload_dir/database-counts.txt" "$restore_tmp_dir/restored-database-counts.txt"

NIX_ALLOW_TEST_CONFIG=1 "$repo_root/scripts/check-migrations" "$restore_config"
docker run --rm --volume "$restore_tmp_dir:/work" "$archive_helper_image" sh -ec '
  chown 0:0 /work/hermes-telegram-mode.env
  chmod 0600 /work/hermes-telegram-mode.env
'
"${compose_restore[@]}" up -d --wait paperclip
health_json=$("${compose_restore[@]}" exec -T paperclip curl -fsS http://127.0.0.1:3100/api/health)
grep -q '"status":"ok"' <<<"$health_json" || fail "restored Paperclip health did not report ok"

if [[ "$restore_require_specialist_topology" == true ]]; then
  specialist_environment_id=$(read_config_value NIX_SPECIALIST_ENVIRONMENT_ID)
  chief_agent_id=$(read_config_value NIX_CHIEF_AGENT_ID)
  company_id=$("${compose_restore[@]}" exec -T postgres psql \
    --username paperclip --dbname paperclip --tuples-only --no-align \
    --command "SELECT company_id FROM agents WHERE id = '$chief_agent_id' LIMIT 1;" | tr -d '[:space:]')
  [[ "$company_id" =~ ^[0-9a-fA-F-]{36}$ ]] \
    || fail "could not resolve the restored specialist company"
  plugins_json=$(restore_board_request GET "/api/plugins") \
    || fail "could not read restored Paperclip plugins"
  jq -e '
    [.[] | select(.packageName == "@paperclipai/plugin-daytona" and .version == "0.1.7")]
    | length == 1
    and .[0].status == "ready"
    and .[0].pluginKey == "paperclip.daytona-sandbox-provider"
    and .[0].manifestJson.id == "paperclip.daytona-sandbox-provider"
    and .[0].manifestJson.version == "0.1.7"
    and (.[0].manifestJson.capabilities | index("environment.drivers.register") != null)
  ' >/dev/null <<<"$plugins_json" || fail "restored exact Daytona plugin is not ready"
  daytona_plugin_id=$(jq -er '.[] | select(.pluginKey == "paperclip.daytona-sandbox-provider") | .id' \
    <<<"$plugins_json") || fail "restored Daytona plugin identifier is missing"
  capabilities_json=$(restore_board_request GET "/api/companies/${company_id}/environments/capabilities") \
    || fail "could not read restored environment capabilities"
  jq -e --arg plugin_id "$daytona_plugin_id" '
    .sandboxProviders.daytona.status == "supported"
    and .sandboxProviders.daytona.source == "plugin"
    and .sandboxProviders.daytona.pluginKey == "paperclip.daytona-sandbox-provider"
    and .sandboxProviders.daytona.pluginId == $plugin_id
    and .sandboxProviders.daytona.supportsSavedProbe == true
    and .sandboxProviders.daytona.supportsUnsavedProbe == true
    and .sandboxProviders.daytona.supportsRunExecution == true
  ' >/dev/null <<<"$capabilities_json" || fail "restored Daytona plugin worker is not execution-ready"
  environments_json=$(restore_board_request GET "/api/companies/${company_id}/environments") \
    || fail "could not read the restored specialist environment through the supported API"
  secret_ids=$(jq -er --arg id "$specialist_environment_id" '
    (if type == "array" then . else (.environments // .items // .data // []) end) as $rows
    | [($rows[] | select(.id == $id))] as $matches
    | if ($matches | length) != 1 then error("specialist environment missing") else $matches[0] end
    | if .driver != "sandbox" or .config.provider != "daytona"
        or .config.image != "daytonaio/sandbox:0.8.0@sha256:eadf88e4391072b7ad4bed27d9cadfc9fe9d8ed375d9219d34c2ccb518f213e3"
        or .config.target != "eu" or .config.cpu != 1 or .config.memory != 2 or .config.disk != 5
        or .config.reuseLease != false or .config.autoDeleteInterval != 60
        or .config.runnerLifecycleMode != "per_turn"
      then error("specialist Daytona environment drifted") else . end
    | [.config.apiKey, .envVars.OPENCODE_API_KEY.secretId]
    | if length != 2 or any(. == null or . == "") or .[0] == .[1]
      then error("specialist secret references invalid") else .[] end
  ' <<<"$environments_json") || fail "restored specialist environment bindings are invalid"
  secrets_json=$(restore_board_request GET "/api/companies/${company_id}/secrets") \
    || fail "could not read restored specialist secret metadata"
  while IFS= read -r secret_id; do
    jq -e --arg id "$secret_id" '[.[] | select(.id == $id)] | length == 1' >/dev/null <<<"$secrets_json" \
      || fail "restored specialist secret metadata is incomplete"
  done <<<"$secret_ids"
  # Expansion must occur in the restored container, not this operator shell.
  # shellcheck disable=SC2016
  "${compose_restore[@]}" exec -T paperclip sh -ec \
    'test -z "${DAYTONA_API_KEY:-}" && test -z "${OPENCODE_API_KEY:-}"' \
    || fail "specialist provider credentials leaked into the Paperclip host environment"
  unset capabilities_json daytona_plugin_id environments_json plugins_json secrets_json secret_ids cookie_header
fi

"${compose_restore[@]}" up -d --wait hermes
api_key=$(grep -E '^API_SERVER_KEY=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
[[ ${#api_key} -ge 64 ]] || fail "restored Hermes API key is missing or too short"
unauthorized=$("${compose_restore[@]}" exec -T paperclip curl -sS -o /dev/null -w '%{http_code}' \
  http://hermes:8642/v1/capabilities)
[[ "$unauthorized" == 401 ]] || fail "restored Hermes API accepted unauthenticated access (HTTP $unauthorized)"
printf 'header = "Authorization: Bearer %s"\n' "$api_key" \
  | "${compose_restore[@]}" exec -T paperclip curl -fsS -K - http://hermes:8642/v1/capabilities >/dev/null
toolsets_json=$(printf 'header = "Authorization: Bearer %s"\n' "$api_key" \
  | "${compose_restore[@]}" exec -T paperclip curl -fsS -K - http://hermes:8642/v1/toolsets)
printf '%s' "$toolsets_json" \
  | "${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py api >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py runtime >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py files >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 hermes \
  python3 /opt/nix/patch-run-attribution.py --verify >/dev/null \
  || fail "restored Hermes runtime attribution patch failed exact-hash verification"
telegram_token=$(grep -E '^TELEGRAM_BOT_TOKEN=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
telegram_token_digest=$(printf '%s' "$telegram_token" \
  | python3 -c 'import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')
unset telegram_token
telegram_users=$(grep -E '^TELEGRAM_ALLOWED_USERS=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
telegram_home=$(grep -E '^TELEGRAM_HOME_CHANNEL=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
telegram_allow_all=$(grep -E '^TELEGRAM_ALLOW_ALL_USERS=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
gateway_allow_all=$(grep -E '^GATEWAY_ALLOW_ALL_USERS=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
"${compose_restore[@]}" exec -T --user 10000:10000 \
  -e NIX_EXPECT_TELEGRAM_MODE=disabled \
  -e "NIX_EXPECT_TELEGRAM_TOKEN_SHA256=$telegram_token_digest" \
  -e "NIX_EXPECT_TELEGRAM_ALLOWED_USERS=$telegram_users" \
  -e "NIX_EXPECT_TELEGRAM_HOME_CHANNEL=$telegram_home" \
  -e "NIX_EXPECT_TELEGRAM_ALLOW_ALL_USERS=$telegram_allow_all" \
  -e "NIX_EXPECT_GATEWAY_ALLOW_ALL_USERS=$gateway_allow_all" \
  -e "NIX_EXPECT_PAPERCLIP_LIOR_USER_ID=$source_lior_user_id" \
  -e "NIX_EXPECT_BRAIN_GID=$restore_brain_gid" hermes \
  python3 /opt/nix/validate-tool-boundary.py processes >/dev/null \
  || fail "restored Hermes process ownership or Telegram-disable boundary is unsafe"
# shellcheck disable=SC2016
"${compose_restore[@]}" exec -T --user 10000:10000 hermes sh -ec '
  test -f /opt/data/config.yaml
  test -f /opt/data/SOUL.md
  test -r /opt/data/.env
  test "$(stat -c %a /opt/data/.env)" = 600
  test "$(stat -c %u:%g /opt/data/.env)" = 10000:10000
  if test -e /opt/data/auth.json; then
    test "$(stat -c %a /opt/data/auth.json)" = 600
    test "$(stat -c %u:%g /opt/data/auth.json)" = 10000:10000
  fi
  test -s /opt/data/.paperclip-claim-receipt.json
  test "$(stat -c %a /opt/data/.paperclip-claim-receipt.json)" = 600
  test "$(stat -c %u:%g /opt/data/.paperclip-claim-receipt.json)" = 10000:10000
' || fail "restored Chief profile or credential receipt is incomplete"
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/verify-paperclip-mcp.py >/dev/null \
  || fail "restored Hermes could not resolve its identity through the bounded Paperclip MCP"

printf 'Restore smoke passed for isolated project %s, including a booted restricted Hermes profile.\n' "$restore_project"
if [[ ${RESTORE_KEEP:-false} == true ]]; then
  printf 'Restore project retained. Remove it with:\n  docker compose --env-file %s down --volumes\n' "$restore_config"
  printf 'RESTORE_CONFIG=%s\n' "$restore_config"
fi
