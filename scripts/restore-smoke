#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
artifact=${1:-}
archive_helper_image='postgres:17.11-alpine3.24@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24'
restore_tmp_dir=''
restore_started=0

fail() {
  printf 'restore smoke error: %s\n' "$*" >&2
  exit 1
}

hash_check() {
  local checksum_file=$1
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum --check "$checksum_file"
  else
    shasum -a 256 --check "$checksum_file"
  fi
}

cleanup() {
  if [[ $restore_started == 1 && ${RESTORE_KEEP:-false} != true ]]; then
    docker compose --env-file "$restore_config" down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
  if [[ ${RESTORE_KEEP:-false} != true && -n "$restore_tmp_dir" ]]; then
    rm -rf "$restore_tmp_dir"
  fi
}
trap cleanup EXIT

[[ -n "$artifact" ]] || fail "usage: $0 /absolute/path/to/backup.tar.gz[.age]"
[[ "$artifact" == /* ]] || fail "backup artifact path must be absolute"
[[ -f "$artifact" ]] || fail "backup artifact does not exist: $artifact"

if [[ -f "${artifact}.sha256" ]]; then
  (cd "$(dirname "$artifact")" && hash_check "$(basename "$artifact").sha256")
fi

if [[ -n ${RESTORE_WORK_DIR:-} ]]; then
  [[ ! -e "$RESTORE_WORK_DIR" ]] || fail "RESTORE_WORK_DIR already exists: $RESTORE_WORK_DIR"
  mkdir -p "$RESTORE_WORK_DIR"
  restore_tmp_dir=$RESTORE_WORK_DIR
else
  restore_tmp_dir=$(mktemp -d /tmp/nix-os-restore.XXXXXX)
fi
archive="$artifact"
if [[ "$artifact" == *.age ]]; then
  command -v age >/dev/null 2>&1 || fail "age is required to decrypt $artifact"
  [[ -n ${AGE_IDENTITY_FILE:-} ]] || fail "set AGE_IDENTITY_FILE to decrypt the backup"
  archive="$restore_tmp_dir/backup.tar.gz"
  age --decrypt --identity "$AGE_IDENTITY_FILE" --output "$archive" "$artifact"
fi

tar -xzf "$archive" -C "$restore_tmp_dir"
payload_dir=$(find "$restore_tmp_dir" -mindepth 1 -maxdepth 1 -type d -name 'nix-os-*' -print -quit)
[[ -n "$payload_dir" ]] || fail "backup payload directory is missing"
(
  cd "$payload_dir"
  hash_check SHA256SUMS
)

source_project=$(grep -E '^SOURCE_PROJECT=' "$payload_dir/manifest.env" | cut -d= -f2-)
restore_project=${RESTORE_PROJECT_NAME:-nix-os-restore-$$}
[[ "$restore_project" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || fail "invalid RESTORE_PROJECT_NAME"
[[ "$restore_project" != "$source_project" ]] || fail "restore project must differ from source project"
[[ "$restore_project" != nix-os ]] || fail "refusing to use the production project name"

restore_postgres_volume="${restore_project}_postgres_data"
restore_paperclip_volume="${restore_project}_paperclip_data"
restore_hermes_volume="${restore_project}_hermes_data"
for restore_volume in "$restore_postgres_volume" "$restore_paperclip_volume" "$restore_hermes_volume"; do
  if docker volume inspect "$restore_volume" >/dev/null 2>&1; then
    fail "restore target volume already exists: $restore_volume"
  fi
done

restore_postgres_env="$restore_tmp_dir/postgres.env"
restore_paperclip_env="$restore_tmp_dir/paperclip.env"
restore_hermes_env="$restore_tmp_dir/hermes.env"
restore_hermes_mode="$restore_tmp_dir/hermes-telegram-mode.env"
restore_brain="$restore_tmp_dir/nix-brain"
restore_config="$restore_tmp_dir/restore.env"
if [[ -n ${RESTORE_POSTGRES_ENV_FILE:-} || -n ${RESTORE_PAPERCLIP_ENV_FILE:-} || -n ${RESTORE_HERMES_ENV_FILE:-} ]]; then
  [[ -n ${RESTORE_POSTGRES_ENV_FILE:-} && -f "$RESTORE_POSTGRES_ENV_FILE" ]] \
    || fail "RESTORE_POSTGRES_ENV_FILE must name the restored PostgreSQL secret file"
  [[ -n ${RESTORE_PAPERCLIP_ENV_FILE:-} && -f "$RESTORE_PAPERCLIP_ENV_FILE" ]] \
    || fail "RESTORE_PAPERCLIP_ENV_FILE must name the restored Paperclip secret file"
  [[ -n ${RESTORE_HERMES_ENV_FILE:-} && -f "$RESTORE_HERMES_ENV_FILE" ]] \
    || fail "RESTORE_HERMES_ENV_FILE must name the restored Hermes secret file"
  install -m 0600 "$RESTORE_POSTGRES_ENV_FILE" "$restore_postgres_env"
  install -m 0600 "$RESTORE_PAPERCLIP_ENV_FILE" "$restore_paperclip_env"
  install -m 0600 "$RESTORE_HERMES_ENV_FILE" "$restore_hermes_env"
else
  postgres_password=$(openssl rand -hex 32)
  paperclip_db_password=$(openssl rand -hex 32)
  better_auth_secret=$(openssl rand -hex 32)
  tool_action_secret=$(openssl rand -hex 32)
  printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password" >"$restore_postgres_env"
  printf 'PAPERCLIP_DB_PASSWORD=%s\n' "$paperclip_db_password" >>"$restore_postgres_env"
  {
    printf 'DATABASE_URL=postgresql://paperclip:%s@postgres:5432/paperclip\n' "$paperclip_db_password"
    printf 'BETTER_AUTH_SECRET=%s\n' "$better_auth_secret"
    printf 'PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=%s\n' "$tool_action_secret"
  } >"$restore_paperclip_env"
  {
    printf 'API_SERVER_KEY=%s\n' "$(openssl rand -hex 32)"
    printf 'TELEGRAM_BOT_TOKEN=test-token\n'
    printf 'TELEGRAM_ALLOWED_USERS=123456789\n'
    printf 'TELEGRAM_ALLOW_ALL_USERS=false\nGATEWAY_ALLOW_ALL_USERS=false\n'
  } >"$restore_hermes_env"
fi
mkdir -p "$restore_brain"
{
  printf 'COMPOSE_PROJECT_NAME=%s\n' "$restore_project"
  printf 'PAPERCLIP_PUBLIC_URL=https://nix-os.restore-test.ts.net\n'
  printf 'PAPERCLIP_LIOR_USER_ID=lior-restore-test-user\n'
  printf 'PAPERCLIP_HOST_PORT=0\n'
  printf 'POSTGRES_ENV_FILE=%s\n' "$restore_postgres_env"
  printf 'PAPERCLIP_ENV_FILE=%s\n' "$restore_paperclip_env"
  printf 'HERMES_ENV_FILE=%s\n' "$restore_hermes_env"
  printf 'HERMES_TELEGRAM_MODE_FILE=%s\n' "$restore_hermes_mode"
  printf 'NIX_BRAIN_HOST_PATH=%s\n' "$restore_brain"
  printf 'PAPERCLIP_AUTH_DISABLE_SIGN_UP=true\n'
  printf 'BACKUP_OUTPUT_DIR=%s\n' "$restore_tmp_dir/backups"
} >"$restore_config"
chmod 0600 "$restore_postgres_env" "$restore_paperclip_env" "$restore_hermes_env" "$restore_config"
printf 'HERMES_TELEGRAM_MODE=disabled\n' >"$restore_hermes_mode"
chmod 0600 "$restore_hermes_mode"

compose_restore=(docker compose -f "$repo_root/compose.yaml" --env-file "$restore_config")
"${compose_restore[@]}" create postgres paperclip hermes >/dev/null
restore_started=1
docker run --rm \
  --volume "$restore_paperclip_volume:/target" \
  --volume "$payload_dir:/backup:ro" \
  "$archive_helper_image" sh -ec 'find /target -mindepth 1 -delete && cd /target && tar -xzf /backup/paperclip-data.tar.gz'

docker run --rm \
  --volume "$restore_paperclip_volume:/source:ro" \
  --volume "$restore_tmp_dir:/verify" \
  "$archive_helper_image" sh -ec 'cd /source && find . -type f -exec sha256sum {} \; | sort > /verify/restored-paperclip-files.sha256'
diff -u "$payload_dir/paperclip-files.sha256" "$restore_tmp_dir/restored-paperclip-files.sha256"

docker run --rm \
  --volume "$restore_hermes_volume:/target" \
  --volume "$payload_dir:/backup:ro" \
  "$archive_helper_image" sh -ec 'find /target -mindepth 1 -delete && cd /target && tar -xzf /backup/hermes-data.tar.gz'
docker run --rm --volume "$restore_hermes_volume:/state:ro" "$archive_helper_image" sh -ec '
  for path in .env auth.json .paperclip-claim-receipt.json; do
    test -f "/state/$path"
    test "$(stat -c %u:%g "/state/$path")" = 10000:10000
    test "$(stat -c %a "/state/$path")" = 600
  done
  test "$(find /state -maxdepth 1 -name ".paperclip-claim-*.pending" | wc -l | tr -d " ")" = 0
  test ! -e /state/mcp-tokens/nix-os-paperclip-claim-stage.json
' || fail "restored Hermes credentials/auth/claim receipt metadata is unsafe"
docker run --rm \
  --volume "$restore_hermes_volume:/source:ro" \
  --volume "$restore_tmp_dir:/verify" \
  "$archive_helper_image" sh -ec 'cd /source && find . -type f -exec sha256sum {} \; | sort > /verify/restored-hermes-files.sha256'
diff -u "$payload_dir/hermes-files.sha256" "$restore_tmp_dir/restored-hermes-files.sha256"

if [[ ${NIX_RESTORE_INJECT_PROFILE_TELEGRAM_CANARY:-0} == 1 ]]; then
  docker run --rm --user 10000:10000 --volume "$restore_hermes_volume:/state" "$archive_helper_image" sh -ec '
    existing=$(mktemp)
    cp /state/.env "$existing"
    printf "\357\273\277%s\n" "TELEGRAM_BOT_TOKEN=restored-profile-token-must-not-poll" > /state/.env
    printf "%s\n" \
      "'TELEGRAM_ALLOWED_USERS'=999999999" \
      "TELEGRAM_ALLOW_ALL_USERS=true" \
      "GATEWAY_ALLOW_ALL_USERS=true" >> /state/.env
    cat "$existing" >> /state/.env
    rm -f "$existing"
  '
fi

"${compose_restore[@]}" up -d --wait postgres
"${compose_restore[@]}" exec -T postgres pg_restore \
  --username paperclip \
  --dbname paperclip \
  --clean \
  --if-exists \
  --no-owner \
  --no-privileges <"$payload_dir/postgres.dump"

"${compose_restore[@]}" exec -T postgres psql --username paperclip --dbname paperclip --tuples-only --no-align \
  --command "SELECT 'public_tables=' || count(*) FROM information_schema.tables WHERE table_schema = 'public'; SELECT 'companies=' || count(*) FROM companies; SELECT 'issues=' || count(*) FROM issues; SELECT 'documents=' || count(*) FROM documents;" \
  >"$restore_tmp_dir/restored-database-counts.txt"
diff -u "$payload_dir/database-counts.txt" "$restore_tmp_dir/restored-database-counts.txt"

NIX_ALLOW_TEST_CONFIG=1 "$repo_root/scripts/check-migrations" "$restore_config"
docker run --rm --volume "$restore_tmp_dir:/work" "$archive_helper_image" sh -ec '
  chown 0:0 /work/hermes-telegram-mode.env
  chmod 0600 /work/hermes-telegram-mode.env
'
"${compose_restore[@]}" up -d --wait paperclip
health_json=$("${compose_restore[@]}" exec -T paperclip curl -fsS http://127.0.0.1:3100/api/health)
grep -q '"status":"ok"' <<<"$health_json" || fail "restored Paperclip health did not report ok"

"${compose_restore[@]}" up -d --wait hermes
api_key=$(grep -E '^API_SERVER_KEY=' "$restore_hermes_env" | tail -n 1 | cut -d= -f2-)
[[ ${#api_key} -ge 64 ]] || fail "restored Hermes API key is missing or too short"
unauthorized=$("${compose_restore[@]}" exec -T paperclip curl -sS -o /dev/null -w '%{http_code}' \
  http://hermes:8642/v1/capabilities)
[[ "$unauthorized" == 401 ]] || fail "restored Hermes API accepted unauthenticated access (HTTP $unauthorized)"
printf 'header = "Authorization: Bearer %s"\n' "$api_key" \
  | "${compose_restore[@]}" exec -T paperclip curl -fsS -K - http://hermes:8642/v1/capabilities >/dev/null
toolsets_json=$(printf 'header = "Authorization: Bearer %s"\n' "$api_key" \
  | "${compose_restore[@]}" exec -T paperclip curl -fsS -K - http://hermes:8642/v1/toolsets)
printf '%s' "$toolsets_json" \
  | "${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py api >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py runtime >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/validate-tool-boundary.py files >/dev/null
"${compose_restore[@]}" exec -T --user 10000:10000 -e NIX_EXPECT_TELEGRAM_MODE=disabled hermes \
  python3 /opt/nix/validate-tool-boundary.py processes >/dev/null \
  || fail "restored Hermes process ownership or Telegram-disable boundary is unsafe"
# shellcheck disable=SC2016
"${compose_restore[@]}" exec -T --user 10000:10000 hermes sh -ec '
  test -f /opt/data/config.yaml
  test -f /opt/data/SOUL.md
  test -r /opt/data/.env
  test "$(stat -c %a /opt/data/.env)" = 600
  test "$(stat -c %u:%g /opt/data/.env)" = 10000:10000
  test "$(stat -c %a /opt/data/auth.json)" = 600
  test "$(stat -c %u:%g /opt/data/auth.json)" = 10000:10000
  test -s /opt/data/.paperclip-claim-receipt.json
  test "$(stat -c %a /opt/data/.paperclip-claim-receipt.json)" = 600
  test "$(stat -c %u:%g /opt/data/.paperclip-claim-receipt.json)" = 10000:10000
' || fail "restored Chief profile or credential receipt is incomplete"
"${compose_restore[@]}" exec -T --user 10000:10000 hermes python3 /opt/nix/verify-paperclip-mcp.py >/dev/null \
  || fail "restored Hermes could not resolve its identity through the bounded Paperclip MCP"

printf 'Restore smoke passed for isolated project %s, including a booted restricted Hermes profile.\n' "$restore_project"
if [[ ${RESTORE_KEEP:-false} == true ]]; then
  printf 'Restore project retained. Remove it with:\n  docker compose --env-file %s down --volumes\n' "$restore_config"
  printf 'RESTORE_CONFIG=%s\n' "$restore_config"
fi
