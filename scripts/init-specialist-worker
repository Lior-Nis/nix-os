#!/usr/bin/env bash
set -euo pipefail
umask 077

target_dir=${1:-/etc/nix-os/specialist-worker}
[[ "$target_dir" == /* && "$target_dir" != / && "$target_dir" != "$HOME" ]] \
  || { printf 'specialist worker key error: target must be a specific absolute directory\n' >&2; exit 1; }
command -v ssh-keygen >/dev/null 2>&1 \
  || { printf 'specialist worker key error: ssh-keygen is required\n' >&2; exit 1; }

install -d -m 0700 "$target_dir"
for path in host_ed25519 client_ed25519 authorized_keys; do
  [[ ! -e "$target_dir/$path" ]] \
    || { printf 'specialist worker key error: refusing to replace %s\n' "$target_dir/$path" >&2; exit 1; }
done

ssh-keygen -q -t ed25519 -N '' -C nix-specialist-worker-host -f "$target_dir/host_ed25519"
ssh-keygen -q -t ed25519 -N '' -C nix-paperclip-worker-client -f "$target_dir/client_ed25519"
{
  printf 'restrict '
  cat "$target_dir/client_ed25519.pub"
} >"$target_dir/authorized_keys"
chmod 0600 "$target_dir/host_ed25519" "$target_dir/client_ed25519" "$target_dir/authorized_keys"
chmod 0644 "$target_dir/host_ed25519.pub" "$target_dir/client_ed25519.pub"

printf 'Specialist worker SSH identity created. Private key material was not logged.\n'
