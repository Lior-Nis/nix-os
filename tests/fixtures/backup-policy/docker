#!/usr/bin/env bash
set -euo pipefail

if [[ -n ${FAKE_DOCKER_LOG:-} ]]; then
  printf '%s\n' "$*" >>"$FAKE_DOCKER_LOG"
fi

if [[ ${1:-} == compose ]]; then
  shift
  if [[ ${1:-} == version ]]; then
    exit 0
  fi
  operation=''
  for argument in "$@"; do
    case "$argument" in
      config|exec|ps|stop|up) operation=$argument; break ;;
    esac
  done
  case "$operation" in
    config)
      if [[ " $* " == *' --format json '* ]]; then
        printf '%s\n' '{"services":{"hermes":{"image":"fixture-hermes@sha256:fixture"}}}'
      elif [[ " $* " == *' --images '* ]]; then
        printf 'fixture-image@sha256:fixture\n'
      fi
      ;;
    exec)
      if [[ " $* " == *' pg_dump '* ]]; then
        printf 'fixture-postgres-dump\n'
      elif [[ " $* " == *' json_build_object('* ]]; then
        topology_query_count=1
        if [[ -n ${FAKE_DOCKER_LOG:-} ]]; then
          topology_query_count=$(grep -c '^SELECT json_build_object(' "$FAKE_DOCKER_LOG" || true)
        fi
        if [[ ${FAKE_TOPOLOGY_UNSAFE:-0} == 1 ]] \
          || [[ ${FAKE_TOPOLOGY_DRIFT_AFTER_STOP:-0} == 1 && $topology_query_count -ge 2 ]]; then
          printf '%s\n' '{"agents":[],"keys":[]}'
        else
          printf '%s\n' '{"agents":[{"id":"22222222-2222-4222-8222-222222222222","name":"Chief of Staff","role":"ceo","status":"idle","reportsTo":null,"hasNixBootstrap":false,"marker":null,"budgetMonthlyCents":0,"permissions":{"canCreateAgents":false,"canCreateSkills":false,"canAssignTasks":true},"tempAdapterSafe":null,"tempRuntimeSafe":null,"chiefGatewaySafe":true,"chiefHasApiKey":true,"chiefGatewayKeyHash":"add5b41fc5a881fc87ef4640581ed5ff7fe5eab39640b3a3e6e8b90f0aa71730"},{"id":"33333333-3333-4333-8333-333333333333","name":"Nix Bootstrap CEO","role":"general","status":"paused","reportsTo":"22222222-2222-4222-8222-222222222222","hasNixBootstrap":true,"marker":{"kind":"temporary-chief-manager","version":1},"budgetMonthlyCents":0,"permissions":{"canCreateAgents":false,"canCreateSkills":false,"canAssignTasks":false},"tempAdapterSafe":true,"tempRuntimeSafe":true,"chiefGatewaySafe":null,"chiefHasApiKey":null,"chiefGatewayKeyHash":null}],"keys":[{"id":"44444444-4444-4444-8444-444444444444","agentId":"22222222-2222-4222-8222-222222222222","revoked":false,"scopeKind":"standard","responsibleUserId":"lior-test-user","keyHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}'
        fi
      elif [[ " $* " == *' psql '* ]]; then
        printf '%s\n' 'public_tables=1' 'companies=1' 'issues=1' 'documents=1'
      fi
      ;;
    ps)
      if [[ ${FAKE_TOPOLOGY_DRIFT_AFTER_STOP:-0} == 1 && " $* " == *' --status running --services '* ]]; then
        printf '%s\n' hermes paperclip
      fi
      ;;
    stop|up) ;;
    *) exit 2 ;;
  esac
  exit 0
fi

if [[ ${1:-} == volume && ${2:-} == inspect ]]; then
  exit 0
fi

if [[ ${1:-} == run ]]; then
  if [[ " $* " == *' /opt/nix/check-paperclip-chief-topology --read-claim /opt/data '* ]]; then
    printf '%s\n' '{"credentialPresent":true,"credentialSha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","companyId":"11111111-1111-4111-8111-111111111111","agentId":"22222222-2222-4222-8222-222222222222","receipt":{"requestId":"55555555-5555-4555-8555-555555555555","companyId":"11111111-1111-4111-8111-111111111111","agentId":"22222222-2222-4222-8222-222222222222","keyId":"44444444-4444-4444-8444-444444444444"}}'
    exit 0
  fi
  if [[ " $* " == *' /opt/nix/startup-boundary.py --check-profile-only '* ]]; then
    exit 0
  fi
  backup_dir=''
  source_volume=''
  while (( $# > 0 )); do
    if [[ $1 == --volume ]]; then
      shift
      case "$1" in
        *:/backup) backup_dir=${1%:/backup} ;;
        *:/source:ro) source_volume=${1%:/source:ro} ;;
      esac
    fi
    shift
  done
  [[ -n "$backup_dir" && -n "$source_volume" ]] || exit 2
  if [[ $source_volume == *_paperclip_data ]]; then
    printf 'fixture paperclip archive\n' >"$backup_dir/paperclip-data.tar.gz"
    printf 'fixture  ./fixture-paperclip\n' >"$backup_dir/paperclip-files.sha256"
  elif [[ $source_volume == *_hermes_data ]]; then
    printf 'fixture hermes credential archive\n' >"$backup_dir/hermes-data.tar.gz"
    printf 'fixture  ./fixture-hermes\n' >"$backup_dir/hermes-files.sha256"
  else
    exit 2
  fi
  exit 0
fi

exit 2
