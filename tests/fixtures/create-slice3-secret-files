#!/usr/bin/env bash
set -euo pipefail
umask 077

target_dir=${1:-}
telegram_user=${2:-123456789}

[[ -n "$target_dir" && "$target_dir" == /* && -d "$target_dir" ]] \
  || { printf 'usage: %s /absolute/existing/directory [telegram-user]\n' "$0" >&2; exit 1; }

printf 'NIX_FOUNDER_RELAY_SECRET=abababababababababababababababababababababababababababababababab\n' \
  >"$target_dir/founder-relay.env"
printf 'NIX_LIOR_TELEGRAM_USER_ID=%s\n' "$telegram_user" >>"$target_dir/founder-relay.env"
printf 'NIX_LIOR_TELEGRAM_CHAT_ID=%s\n' "$telegram_user" >>"$target_dir/founder-relay.env"

printf 'OPENCODE_API_KEY=test-restricted-opencode-key-12345678\n' \
  >"$target_dir/specialist-provider.env"

ssh-keygen -q -t ed25519 -N '' -C test-specialist-host -f "$target_dir/specialist-host-key"
ssh-keygen -q -t ed25519 -N '' -C test-specialist-client -f "$target_dir/specialist-client-key"
{
  printf 'restrict '
  cat "$target_dir/specialist-client-key.pub"
} >"$target_dir/specialist-authorized-keys"

chmod 0600 \
  "$target_dir/founder-relay.env" \
  "$target_dir/specialist-provider.env" \
  "$target_dir/specialist-host-key" \
  "$target_dir/specialist-client-key" \
  "$target_dir/specialist-authorized-keys"
