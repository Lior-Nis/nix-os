#!/bin/sh
set -eu

repo_root=$(cd "$(dirname "$0")/../.." && pwd)
reserved="$repo_root/deploy/hermes/pinned-system-gids.txt"

for gid in $(id -G); do
  case "$gid" in
    ''|*[!0-9]*|0|10000) continue ;;
  esac
  if ! grep -qx "$gid" "$reserved"; then
    printf '%s\n' "$gid"
    exit 0
  fi
done

if [ "$(id -u)" -eq 0 ]; then
  printf '%s\n' 12345
  exit 0
fi

printf 'no collision-free supplemental group is available for the brain fixture\n' >&2
exit 1
