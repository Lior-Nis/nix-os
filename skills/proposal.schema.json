{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://its-nix.example/schemas/skill-proposal.schema.json",
  "title": "Nix OS skill proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "profile", "name", "summary", "rationale", "source_url", "repository", "skill_path", "revision", "license", "evidence_urls", "risks", "score_components", "score", "gates", "gate_evidence", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "profile": {"enum": ["lnx", "pulse", "algua", "meabeclick", "meabeclickux", "meabeclickeng", "meabeclickgrowth"]},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "summary": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "skill_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "evidence_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "score_components": {"$ref": "#/$defs/score_components"},
    "score": {"type": "integer", "minimum": 80, "maximum": 100},
    "gates": {"$ref": "#/$defs/gates"},
    "gate_evidence": {"$ref": "#/$defs/gate_evidence"},
    "status": {"const": "candidate"},
    "popularity_evidence": {"type": "string"}
  },
  "$defs": {
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_value", "evidence_quality", "security_provenance", "hermes_compatibility", "maintenance", "documentation_license"],
      "properties": {
        "role_value": {"type": "integer", "minimum": 0, "maximum": 30},
        "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 20},
        "security_provenance": {"type": "integer", "minimum": 0, "maximum": 20},
        "hermes_compatibility": {"type": "integer", "minimum": 0, "maximum": 15},
        "maintenance": {"type": "integer", "minimum": 0, "maximum": 10},
        "documentation_license": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "provenance", "reliability", "safety_privacy", "license", "hermes_compatibility", "non_duplication"],
      "properties": {
        "relevance": {"const": true},
        "provenance": {"const": true},
        "reliability": {"const": true},
        "safety_privacy": {"const": true},
        "license": {"const": true},
        "hermes_compatibility": {"const": true},
        "non_duplication": {"const": true}
      }
    },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "provenance", "reliability", "safety_privacy", "license", "hermes_compatibility", "non_duplication"],
      "properties": {
        "relevance": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "reliability": {"type": "string", "minLength": 1},
        "safety_privacy": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "hermes_compatibility": {"type": "string", "minLength": 1},
        "non_duplication": {"type": "string", "minLength": 1}
      }
    }
  }
}
