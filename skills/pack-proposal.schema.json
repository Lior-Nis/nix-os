{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://its-nix.example/schemas/pack-proposal.schema.json",
  "title": "Nix OS pack proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "profile", "pack", "ordered_skills", "nixkit", "request_evidence", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "profile": {"enum": ["lnx", "pulse", "algua", "meabeclick", "meabeclickux", "meabeclickeng", "meabeclickgrowth"]},
    "pack": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "ordered_skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "nixkit": {"$ref": "#/$defs/nixkit"},
    "request_evidence": {"$ref": "#/$defs/evidence"},
    "status": {"const": "pending_approval"}
  },
  "$defs": {
    "nixkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "snapshot_commit", "sources_sha256"],
      "properties": {
        "repository": {"const": "https://github.com/its-nix/kit.git"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "snapshot_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "sources_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "author_id", "channel_id", "message_id", "quote", "timestamp"],
      "properties": {
        "kind": {"const": "request/proposal"},
        "platform": {"const": "discord"},
        "author_id": {"const": "454290355320520714"},
        "channel_id": {"const": "1563181903253737542"},
        "message_id": {"type": "string", "pattern": "^[0-9]{17,20}$"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4096},
        "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    }
  }
}
