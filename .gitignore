# Local secrets. Commit only redacted examples.
.env
.env.*
!.env.example
secrets/
**/secrets/
*.key
*.pem
*.p12
*.pfx
# Documented Nix backup identities belong in the user's home directory, never a checkout.
.config/nix/age/identity.txt
**/.config/nix/age/identity.txt

# Runtime state and backups are not source code.
data/
state/
backups/
workspaces/
restore-work/
*.sqlite
*.sqlite3
*.db
*.dump
*.tar.gz
*.tar.gz.sha256
*.age

