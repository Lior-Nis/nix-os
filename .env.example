# Copy to .env for one deployment. This file contains configuration only.
# Never put passwords, signing secrets, tokens, or database URLs in this file.

# Stable Compose project name. Backup and restore tooling uses it to identify
# named volumes and to refuse an in-place restore.
COMPOSE_PROJECT_NAME=nix-os

# Replace the tailnet placeholder with the MagicDNS name reported by
# `tailscale status --json` after naming the VPS `nix-os`. Paperclip remains
# authenticated even though this URL is reachable only inside the tailnet.
PAPERCLIP_PUBLIC_URL=https://nix-os.<tailnet-name>.ts.net

# Non-secret immutable ID returned by the reviewed `paperclip-chief identify`
# setup action. Privileged bootstrap refuses any other approving browser user.
PAPERCLIP_LIOR_USER_ID=REPLACE_WITH_IDENTIFIED_LIOR_PAPERCLIP_USER_ID

# Host loopback port used by Tailscale Serve. Compose never binds this port to
# a public host interface. Use 0 only in isolated tests for an ephemeral port.
PAPERCLIP_HOST_PORT=3100

# Absolute paths to root-owned (0600) files outside this checkout.
# POSTGRES_ENV_FILE must contain POSTGRES_PASSWORD and a distinct
# PAPERCLIP_DB_PASSWORD. PAPERCLIP_ENV_FILE must contain DATABASE_URL (using
# PAPERCLIP_DB_PASSWORD), BETTER_AUTH_SECRET, and
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET. scripts/init-secrets creates both.
POSTGRES_ENV_FILE=/etc/nix-os/postgres.env
PAPERCLIP_ENV_FILE=/etc/nix-os/paperclip.env

# Hermes runtime secrets live in this additional mode-0600 file. It contains
# the Telegram bot token and Lior allowlist plus the Hermes Runs API key.
# Provider OAuth and the distinct claimed Paperclip agent credential live in
# the persistent Hermes profile and are included only in encrypted state backups.
HERMES_ENV_FILE=/etc/nix-os/hermes.env

# Root-owned mode-0600 marker outside the checkout. It must contain exactly
# HERMES_TELEGRAM_MODE=disabled or HERMES_TELEGRAM_MODE=live. Container entry
# clears the bot token unless this marker explicitly says live, so restarts,
# upgrades, and recovery cannot accidentally create a second poller.
HERMES_TELEGRAM_MODE_FILE=/etc/nix-os/hermes-telegram-mode.env

# Clean, operator-owned clone of the canonical nix-brain repository. Compose
# mounts it read-only; Slice 1 does not give Chief of Staff Git write access.
NIX_BRAIN_HOST_PATH=/opt/nix-brain

# Keep signup enabled only long enough to create the first authenticated user
# and claim the fresh private instance. Set to true immediately afterward.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Local artifacts are sensitive and must be copied to encrypted off-host
# storage. The directory itself must not be inside the Git checkout in
# production. scripts/backup and scripts/backup-config also accept this from
# the process. Pass BACKUP_AGE_RECIPIENT in the command environment; do not
# store the recipient's private identity or remote credentials here.
BACKUP_OUTPUT_DIR=/var/backups/nix-os
