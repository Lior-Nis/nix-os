# Copy to .env for one deployment. This file contains configuration only.
# Never put passwords, signing secrets, tokens, or database URLs in this file.

# Stable Compose project name. Backup and restore tooling uses it to identify
# named volumes and to refuse an in-place restore.
COMPOSE_PROJECT_NAME=nix-os

# Replace both placeholders before deployment. DNS must point the hostname to
# the VPS before Caddy can obtain a public certificate.
PAPERCLIP_HOSTNAME=paperclip.example.invalid
ACME_EMAIL=operator@example.invalid

# Absolute paths to root-owned (0600) files outside this checkout.
# POSTGRES_ENV_FILE must contain POSTGRES_PASSWORD and a distinct
# PAPERCLIP_DB_PASSWORD. PAPERCLIP_ENV_FILE must contain DATABASE_URL (using
# PAPERCLIP_DB_PASSWORD), BETTER_AUTH_SECRET, and
# PAPERCLIP_TOOL_ACTION_SIGNING_SECRET. scripts/init-secrets creates both.
POSTGRES_ENV_FILE=/etc/nix-os/postgres.env
PAPERCLIP_ENV_FILE=/etc/nix-os/paperclip.env

# Keep signup enabled only long enough to create the first authenticated user
# and consume the one-time bootstrap CEO invite. Set to true immediately after.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Local artifacts are sensitive and must be copied to encrypted off-host
# storage. The directory itself must not be inside the Git checkout in
# production. scripts/backup also accepts BACKUP_OUTPUT_DIR from the process.
BACKUP_OUTPUT_DIR=/var/backups/nix-os
