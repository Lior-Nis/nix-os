{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://its-nix.example/schemas/skill-scout-report.schema.json",
  "title": "Weekly profile skill-scout packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "week", "profile", "generated_at", "checked_sources", "rejected_count", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3])$"},
    "profile": {"enum": ["lnx", "pulse", "algua", "meabeclick", "meabeclickux", "meabeclickeng", "meabeclickgrowth"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "checked_sources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "maxLength": 2048, "pattern": "^https://"}},
    "rejected_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "rationale", "source_url", "repository", "skill_path", "revision", "license", "evidence_urls", "risks", "score_components", "score", "gates", "gate_evidence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_url": {"type": "string", "maxLength": 2048, "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/tree/[a-f0-9]{40}/"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "skill_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "license": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence_urls": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "string", "maxLength": 2048, "pattern": "^https://"}},
        "risks": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "score_components": {"$ref": "#/$defs/score_components"},
        "score": {"type": "integer", "minimum": 80, "maximum": 100},
        "gates": {"$ref": "#/$defs/gates"},
        "gate_evidence": {"$ref": "#/$defs/gate_evidence"}
      }
    },
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_value", "evidence_quality", "security_provenance", "hermes_compatibility", "maintenance", "documentation_license"],
      "properties": {
        "role_value": {"type": "integer", "minimum": 0, "maximum": 30},
        "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 20},
        "security_provenance": {"type": "integer", "minimum": 0, "maximum": 20},
        "hermes_compatibility": {"type": "integer", "minimum": 0, "maximum": 15},
        "maintenance": {"type": "integer", "minimum": 0, "maximum": 10},
        "documentation_license": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "provenance", "reliability", "safety_privacy", "license", "hermes_compatibility", "non_duplication"],
      "properties": {
        "relevance": {"const": true},
        "provenance": {"const": true},
        "reliability": {"const": true},
        "safety_privacy": {"const": true},
        "license": {"const": true},
        "hermes_compatibility": {"const": true},
        "non_duplication": {"const": true}
      }
    },
    "gate_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "provenance", "reliability", "safety_privacy", "license", "hermes_compatibility", "non_duplication"],
      "properties": {
        "relevance": {"type": "string", "minLength": 1, "maxLength": 4096},
        "provenance": {"type": "string", "minLength": 1, "maxLength": 4096},
        "reliability": {"type": "string", "minLength": 1, "maxLength": 4096},
        "safety_privacy": {"type": "string", "minLength": 1, "maxLength": 4096},
        "license": {"type": "string", "minLength": 1, "maxLength": 4096},
        "hermes_compatibility": {"type": "string", "minLength": 1, "maxLength": 4096},
        "non_duplication": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
